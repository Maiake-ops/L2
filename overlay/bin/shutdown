#!/bin/sh
# poweroff / reboot / halt for L2 (symlinked to this script).
#
# Signal PID 1 (rcl2) for a clean service-stopping shutdown; fall back to
# rcl2's direct power command only if -f is passed or signaling PID 1 fails.
force=0
[ "${1:-}" = "-f" ] && force=1

case ${0##*/} in
    reboot) cmd=reboot;   sig=USR2 ;;
    halt)   cmd=halt;     sig=QUIT ;;
    *)      cmd=poweroff; sig=USR1 ;;
esac

if [ "$force" = 0 ] && kill -"$sig" 1 2>/dev/null; then
    exit 0
fi
exec /bin/rcl2 "$cmd"
