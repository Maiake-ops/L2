#!/bin/dash
# openssl launcher for the L2 live image.
#
# The real, static openssl lives on the boot medium (l2/ssl), not in RAM.  This
# 1 KiB script mounts the medium read-only if needed and runs it from there, so
# idle RAM is unchanged.  On an installed disk l2install overwrites this file
# with the real binary.   Env: L2_PACK_DEV=/dev/xxx to force the device.
M=${L2_MEDIA:-/media/l2}
P=$M/l2/ssl
if [ ! -x "$P/bin/openssl" ]; then
    _any=0
    for d in ${L2_PACK_DEV:-} /dev/sr[0-9] /dev/sd[a-z] /dev/vd[a-z] /dev/nvme[0-9]n[0-9] /dev/mmcblk[0-9]; do
        [ -b "$d" ] && { _any=1; break; }
    done
    if [ "$_any" = 1 ]; then
        mkdir -p "$M" 2>/dev/null
        n=0
        while [ "$n" -lt 3 ] && [ ! -x "$P/bin/openssl" ]; do
            for d in ${L2_PACK_DEV:-} /dev/sr0 /dev/sr1 /dev/sd[a-z] /dev/sd[a-z][0-9] \
                     /dev/vd[a-z] /dev/vd[a-z][0-9] /dev/nvme[0-9]n[0-9] /dev/nvme[0-9]n[0-9]p[0-9] \
                     /dev/mmcblk[0-9] /dev/mmcblk[0-9]p[0-9]; do
                [ -b "$d" ] || continue
                mount -t iso9660 -o ro "$d" "$M" 2>/dev/null || continue
                [ -x "$P/bin/openssl" ] && break
                # L2 live medium without an ssl pack: stop retrying.
                if [ -f "$M/l2/L2-LIVE" ]; then umount "$M" 2>/dev/null; n=3; break; fi
                umount "$M" 2>/dev/null
            done
            [ -x "$P/bin/openssl" ] || { n=$((n + 1)); [ "$n" -lt 3 ] && sleep 1; }
        done
    fi
fi
if [ ! -x "$P/bin/openssl" ]; then
    echo "openssl: not found on the boot medium (ISO built without the ssl pack?)." >&2
    echo "         rebuild with: l2 build openssl && l2 iso   (see L2_SSL in l2 --help)" >&2
    exit 127
fi
[ -z "${OPENSSL_CONF:-}" ] && [ -r "$P/etc/ssl/openssl.cnf" ] && export OPENSSL_CONF=$P/etc/ssl/openssl.cnf
[ -z "${SSL_CERT_FILE:-}" ] && [ -r "$P/etc/ssl/cert.pem" ] && export SSL_CERT_FILE=$P/etc/ssl/cert.pem
exec "$P/bin/openssl" "$@"
