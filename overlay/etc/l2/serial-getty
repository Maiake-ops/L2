#!/bin/dash
# Start a console on a serial port only if the UART really exists.
# On UART-less hosts exit 125 so rcl2 permanently disables respawn (0 KiB idle RAM).
t=${1:-ttyS0}
type=0
[ -r "/sys/class/tty/$t/type" ] && read -r type < "/sys/class/tty/$t/type"
if [ "${type:-0}" != 0 ] && [ -c "/dev/$t" ]; then
    exec /sbin/rcl2 console "/dev/$t"
fi
exit 125
