# family|path glob (relative to the firmware root).  `l2 build firmware`
# copies what matches for the selected families (L2_WIFI_FAMILIES) into the
# wifi pack, xz-compressing everything except regulatory.db*.
core|regulatory.db
core|regulatory.db.p7s
mt7921|mediatek/WIFI_MT7961_patch_mcu_1_2_hdr.bin
mt7921|mediatek/WIFI_RAM_CODE_MT7961_1.bin
mt7921|mediatek/WIFI_MT7922_patch_mcu_1_1_hdr.bin
mt7921|mediatek/WIFI_RAM_CODE_MT7922_1.bin
mt7921|mediatek/WIFI_MT7925_PATCH_MCU_1_1_hdr.bin
mt7921|mediatek/WIFI_RAM_CODE_MT7925_1_1.bin
iwlwifi|iwlwifi-*.ucode
iwlwifi|iwlwifi-*.pnvm
rtw88|rtw88/*.bin
rtw89|rtw89/*.bin
rtlwifi|rtlwifi/rtl81*.bin
rtlwifi|rtlwifi/rtl8723*.bin
ath9k|ath9k_htc/*.fw
ath10k|ath10k/QCA6174/hw3.0/*
ath10k|ath10k/QCA9377/hw1.0/*
ath10k|ath10k/QCA988X/hw2.0/*
ath11k|ath11k/WCN6855/*/*
ath11k|ath11k/QCA6390/*/*
ath12k|ath12k/WCN7850/*/*
brcm|brcm/brcmfmac*
