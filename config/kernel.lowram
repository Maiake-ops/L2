# L2 "lowram" kernel fragment — STANDALONE on top of `make tinyconfig`.
#
# This is NOT merged over config/kernel.fragment.  It is a separate, additive
# VM/serial-oriented variant whose only job is to boot the L2# shell with
# 10 MiB TOTAL guest RAM (QEMU -m 10M, BIOS ISO).  The default kernel/ISO is
# untouched and keeps full real-hardware support.
#
# Design trade-off (documented for the notes/ owner):
#   * Real-hardware drivers (USB, MMC, NVMe, AHCI, PS/2, USB-HID, I2C-HID,
#     GPIO/pinctrl/clk, cpufreq/cpuidle, thermal, hwmon, LEDs, backlight,
#     framebuffer, physical NICs, wifi) are DROPPED.  This variant will NOT
#     boot a laptop/desktop from USB/SATA/NVMe and has no keyboard/screen.
#   * CPU vulnerability mitigations, KASLR, IBT, microcode loading, perf,
#     MCE and 32-bit emulation are OFF.  This is a deliberate footprint /
#     determinism trade for a throwaway VM guest ONLY.  Do NOT run this
#     kernel on bare metal or on a host that processes untrusted workloads:
#     Spectre/Meltdown/L1TF/MDS/Retbleed/etc. are unmitigated and the kernel
#     base address is fixed.  See the security note in the report.
#   * What is KEPT is exactly what a QEMU "pc" guest needs to reach the
#     initramfs shell over serial and power off cleanly: PIIX3 IDE CD-ROM
#     (ATA_PIIX + SCSI + SR + ISO9660/JOLIET), virtio blk, PCI/MSI,
#     ACPI core (S5 poweroff works WITHOUT SUSPEND because X86 selects
#     ACPI_SYSTEM_POWER_STATES_SUPPORT whenever ACPI=y), RTC, 8250
#     serial console (VT=n), and AF_UNIX/AF_PACKET local sockets.
#
# Every symbol is re-validated by `make olddefconfig`; symbols this kernel
# renamed are dropped (tools/l2-lowram reports them) rather than failing.

CONFIG_64BIT=y
CONFIG_X86_64=y
# UP (SMP=n): the NR_CPUS=1 footprint lever.  This kernel clamps NR_CPUS>=2 when
# SMP=y, so a single-vCPU kernel requires SMP=n.  A UP kernel boots fine under
# QEMU -smp 2 (the second vCPU is ignored) and saves per-CPU memory: percpu,
# kthreads, per-cpu slab and RCU data.  TRADE-OFF: no SMP guest parallelism.
CONFIG_SMP=n
CONFIG_NR_CPUS=1
CONFIG_X86_5LEVEL=n
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_LAZY=y

# ------------------------------------------------------------------ memory
# EXPERT unlocks the footprint knobs; SLUB_TINY merges slab caches; BASE_SMALL
# shrinks pid/uid/futex hashes AND activates tools/patch-kernel-ram.py (watermark
# floors, vmemmap basepages, streaming initrd free, smaller thread/IRQ stacks).
CONFIG_EXPERT=y
CONFIG_SLUB_TINY=y
CONFIG_BASE_SMALL=y
CONFIG_LOG_BUF_SHIFT=13
CONFIG_NUMA=n
CONFIG_TRANSPARENT_HUGEPAGE=n
CONFIG_KSM=n
CONFIG_COMPACTION=n
CONFIG_SWAP=n
CONFIG_DEFERRED_STRUCT_PAGE_INIT=n
CONFIG_PCP_BATCH_SCALE_MAX=0
# 1 MiB initial bounce pool (was 4): saves ~3 MiB of early reserved RAM.
CONFIG_SWIOTLB_DEFAULT_SIZE_MB=1
CONFIG_SWIOTLB_DYNAMIC=y
CONFIG_SCHED_CACHE=n
CONFIG_SCHED_CLUSTER=n
# SCHED_MC_PRIO is default-y and `select X86_INTEL_PSTATE/X86_AMD_PSTATE/CPU_FREQ`,
# which drag in ACPI_PROCESSOR -> THERMAL/CPU_IDLE/POWER_SUPPLY.  Disable it (and
# the MC/SMT scheduler tiers a 2-vCPU VM does not need) to break that chain.
CONFIG_SCHED_MC=n
CONFIG_SCHED_MC_PRIO=n
CONFIG_SCHED_SMT=n
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
# BUG=n removes __bug_table (~52 KiB) + the BUG() trap sites.  RISK: a kernel
# consistency check that would normally BUG() now continues silently instead of
# halting.  Acceptable for a throwaway VM guest; the default kernel keeps BUG=y.
CONFIG_BUG=n
CONFIG_MAGIC_SYSRQ=y
CONFIG_BLOCK=y
CONFIG_MULTIUSER=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_AIO=n
CONFIG_PROC_PAGE_MONITOR=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n

# userspace ABI
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n
CONFIG_TTY=y
# VT=n footprint lever: no virtual terminals / dummycon / /dev/tty1.  This
# REQUIRES the variant initramfs (tools/l2-lowram initramfs) which removes the
# 'service tty1 respawn ... /dev/tty1' line from rcl2.conf, otherwise that
# service respawn-fails forever.  Serial ttyS0 is the sole console.  With VT=n,
# INPUT is no longer force-selected (VT selects INPUT), so INPUT core drops too.
CONFIG_VT=n
CONFIG_VT_CONSOLE=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=n
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_SERIAL_8250_EXAR=n
CONFIG_SERIAL_8250_MOXA_PCIE=n
CONFIG_SERIAL_8250_LPSS=n
CONFIG_SERIAL_8250_MID=n
CONFIG_SERIAL_8250_PERICOM=n

# boot / initramfs (gzip only; the streaming-free patch reclaims initrd pages)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_XZ_DEC_POWERPC=n
CONFIG_XZ_DEC_ARM=n
CONFIG_XZ_DEC_ARMTHUMB=n
CONFIG_XZ_DEC_ARM64=n
CONFIG_XZ_DEC_SPARC=n
CONFIG_XZ_DEC_RISCV=n
CONFIG_KERNEL_XZ=y

# ------------------------------------------- placement / determinism (VM only)
# Fixed base physical address, no KASLR: PHYSICAL_START(0x200000) + init_size
# must stay below the top-of-RAM initrd that Limine places.  RANDOMIZE_BASE=n
# removes the variability that triple-faulted the 10M BIOS baseline.
CONFIG_RELOCATABLE=y
CONFIG_PHYSICAL_START=0x200000
CONFIG_RANDOMIZE_BASE=n
CONFIG_RANDOMIZE_MEMORY=n
CONFIG_X86_KERNEL_IBT=n
CONFIG_MICROCODE=n
CONFIG_X86_MCE=n
CONFIG_PERF_EVENTS=n
CONFIG_X86_DEBUGCTLMSR=n
CONFIG_PERF_EVENTS_INTEL_UNCORE=n
CONFIG_PERF_EVENTS_INTEL_RAPL=n
CONFIG_PERF_EVENTS_INTEL_CSTATE=n
# All CPU mitigations OFF (this kernel gates them behind CPU_MITIGATIONS).
# SECURITY TRADE-OFF: VM-only throwaway guest; unmitigated speculative-exec
# side channels + fixed kernel base.  Never use on bare metal / untrusted hosts.
CONFIG_CPU_MITIGATIONS=n
CONFIG_FINEIBT=n
CONFIG_FINEIBT_BHI=n
CONFIG_IA32_EMULATION=n
CONFIG_X86_X32_ABI=n
CONFIG_VM86=n
CONFIG_X86_16BIT=n
CONFIG_X86_UMIP=n
# hardening / debug bloat off (footprint)
CONFIG_STACKPROTECTOR=n
CONFIG_RANDOMIZE_KSTACK_OFFSET=n
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=n
CONFIG_INIT_ON_FREE_DEFAULT_ON=n
CONFIG_HARDENED_USERCOPY=n
CONFIG_FORTIFY_SOURCE=n
CONFIG_SHUFFLE_PAGE_ALLOCATOR=n
CONFIG_PAGE_POISONING=n
CONFIG_SCHED_STACK_END_CHECK=n
CONFIG_DEBUG_LIST=n
CONFIG_DEBUG_MISC=n
CONFIG_DEBUG_BUGVERBOSE=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_KALLSYMS=n

# no loadable modules: kills __ksymtab/__ksymtab_strings (~244 KiB) + loader
CONFIG_MODULES=n
CONFIG_MODULE_UNLOAD=n
CONFIG_CRYPTO=n
CONFIG_IKCONFIG=n
CONFIG_KEXEC=n
CONFIG_CRASH_DUMP=n
CONFIG_AUDIT=n
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_USER_NS=n
CONFIG_SYSVIPC=n
CONFIG_SECURITY=n
CONFIG_SECCOMP=n
CONFIG_BPF_SYSCALL=n
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_DEBUG_FS=n
CONFIG_IO_URING=n
CONFIG_POSIX_MQUEUE=n
CONFIG_DEVMEM=n
CONFIG_DEVKMEM=n
CONFIG_PROFILING=n

# ----------------------------------------------------------------- storage
# QEMU "pc" boots the ISO from a PIIX3 IDE CD-ROM: ATA_PIIX + SCSI + SR +
# ISO9660/JOLIET.  virtio blk/net kept for -device virtio.  AHCI/NVMe/MMC/USB
# dropped (a VM has none of them on the boot path).
CONFIG_BLK_DEV=y
# SD (SCSI disk) dropped: the lowram VM boots from CD-ROM (SR) only; a disk
# install would need this re-enabled.  SR + SCSI core stay for the ISO.
CONFIG_BLK_DEV_SD=n
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_BSG=n
CONFIG_SCSI=y
CONFIG_SCSI_PROC_FS=n
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=n
CONFIG_ATA_VERBOSE_ERROR=n
CONFIG_SATA_AHCI=n
CONFIG_NVME_CORE=n
CONFIG_BLK_DEV_NVME=n
CONFIG_MMC=n
CONFIG_MQ_IOSCHED_DEADLINE=n
CONFIG_MQ_IOSCHED_KYBER=n
CONFIG_IOSCHED_BFQ=n
CONFIG_INTEL_MEI=n
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=n
CONFIG_PCI_LABEL=n
# AMD Fam10h MMCONFIG quirk: not needed on QEMU; small footprint cut.
CONFIG_MMCONF_FAM10H=n
# MSDOS partition tables: the ISO boots via El Torito, not a partition table.
CONFIG_MSDOS_PARTITION=n
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
# EXT4 dropped to reach the 10 MiB goal (next-largest fs contributor, ~450 KiB
# image).  TRADE-OFF: no ext4 root — `l2install disk` (ext4) will not work from
# this variant; the live shell boots from the initramfs (tmpfs) + ISO9660 CD.
# The DEFAULT kernel keeps EXT4.  Re-enable EXT4_FS=y for disk-install support
# (raises the boot floor by ~1 MiB).
CONFIG_EXT4_FS=n
CONFIG_EXT4_USE_FOR_EXT2=n
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_VFAT_FS=n
CONFIG_MSDOS_FS=n
CONFIG_EXFAT_FS=n
CONFIG_USB_SUPPORT=n

# ------------------------------------- input / display dropped (VM has none)
# With VT=n nothing selects INPUT, so the INPUT core drops too.  ACPI_BUTTON
# dropped: clean poweroff uses reboot(RB_POWER_OFF) -> acpi_power_off (S5), not
# the button driver.  No keyboard/mouse/evdev/HID/serio, framebuffer, fbcon,
# fonts, LEDs, backlight, I2C, GPIO, pinctrl or common-clk.
CONFIG_INPUT=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_EVDEV=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_MISC=n
CONFIG_SERIO=n
CONFIG_KEYBOARD_ATKBD=n
CONFIG_MOUSE_PS2=n
CONFIG_HID_SUPPORT=n
CONFIG_HID=n
CONFIG_USB_HID=n
CONFIG_I2C=n
CONFIG_PINCTRL=n
CONFIG_PINCTRL_AMD=n
CONFIG_GPIOLIB=n
CONFIG_GPIO_ACPI=n
CONFIG_COMMON_CLK=n
CONFIG_FB=n
CONFIG_FB_VESA=n
CONFIG_FB_EFI=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_FONTS=n
CONFIG_BACKLIGHT_CLASS_DEVICE=n
CONFIG_NEW_LEDS=n
CONFIG_LEDS_CLASS=n

# ------------------------------------------------------------- power / ACPI
# ACPI core kept for clean S5 poweroff (ACPI_BUTTON/INPUT dropped — the syscall
# poweroff path does not need them).  SUSPEND=n is safe: X86 selects
# ACPI_SYSTEM_POWER_STATES_SUPPORT if ACPI, so sleep.o (acpi_power_off) is built
# and registers the SYS_OFF poweroff handler regardless of SUSPEND.
# Verified empirically at 16M (QEMU exits on `poweroff`).
CONFIG_PM=y
CONFIG_SUSPEND=n
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=n
CONFIG_ACPI_AC=n
CONFIG_ACPI_BATTERY=n
CONFIG_ACPI_PROCESSOR=n
CONFIG_ACPI_FAN=n
CONFIG_ACPI_THERMAL=n
CONFIG_ACPI_VIDEO=n
CONFIG_ACPI_WMI=n
CONFIG_ACPI_DEBUG=n
CONFIG_ACPI_TABLE_UPGRADE=n
CONFIG_ACPI_PCC=n
CONFIG_ACPI_PRMT=n
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=n
CONFIG_INTEL_IDLE=n
CONFIG_THERMAL=n
CONFIG_HWMON=n
CONFIG_POWER_SUPPLY=n
# These x86 cpufreq drivers are default-y and `select ACPI_PROCESSOR` (which
# pulls THERMAL/CPU_IDLE/CPU_FREQ) and POWER_SUPPLY.  olddefconfig re-enables
# any default-y symbol left absent, so they MUST be explicitly disabled or the
# whole ACPI-processor/cpufreq/thermal chain comes back.  A VM needs none.
CONFIG_X86_INTEL_PSTATE=n
CONFIG_X86_AMD_PSTATE=n
CONFIG_X86_AMD_PSTATE_UT=n
CONFIG_X86_ACPI_CPUFREQ=n
CONFIG_X86_PCC_CPUFREQ=n
CONFIG_X86_AMD_FREQ_SENSITIVITY=n
CONFIG_X86_POWERNOW_K8=n
CONFIG_X86_SPEEDSTEP_CENTRINO=n
CONFIG_X86_P4_CLOCKMOD=n
CONFIG_X86_LONGRUN=n
CONFIG_X86_LONGHAUL=n
CONFIG_X86_GX_SUSPMOD=n
CONFIG_X86_SPEEDSTEP_ICH=n
CONFIG_X86_SPEEDSTEP_SMI=n
CONFIG_X86_CPUFREQ_NFORCE2=n
CONFIG_X86_E_POWERSAVER=n
CONFIG_ACPI_PLATFORM_PROFILE=n
CONFIG_ACPI_CPPC_LIB=n
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=n
CONFIG_EFI_CUSTOM_SSDT_OVERLAYS=n
CONFIG_IOSF_MBI=n
CONFIG_X86_INTEL_LPSS=n
CONFIG_X86_AMD_PLATFORM_DEVICE=n
CONFIG_PNP_DEBUG_MESSAGES=n

# ---------------------------------------------------------------- networking
# TCP/IP (INET) DROPPED to reach the 10 MiB goal.  Measured forensics: with INET
# the idle unreclaimable slab is ~2.8 MiB (ACPI namespace + rootfs metadata +
# IPv4 stacks); INET is the next-largest Built-in.a contributor (net ~1.1 MiB)
# after drivers.  TRADE-OFF: no IPv4/IPv6, no udhcpc/DHCP, no TCP/UDP sockets.
# This is a VM/serial shell variant booted with -nic none; AF_UNIX + AF_PACKET +
# the NET core (lo) remain for local sockets.  The DEFAULT kernel keeps full
# INET.  Re-enable INET=y for a networking lowram variant (raises the floor).
CONFIG_NET=y
CONFIG_INET=n
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=n
CONFIG_PTP_1588_CLOCK=n
CONFIG_INET_DIAG=n
CONFIG_RPS=n
CONFIG_BQL=n
CONFIG_AF_UNIX_OOB=n
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_IP_MULTICAST=n
CONFIG_IP_ADVANCED_ROUTER=n
CONFIG_INET_TUNNEL=n
CONFIG_INET_IPCOMP=n
CONFIG_XFRM_USER=n
CONFIG_NET_SCHED=n
CONFIG_NET_CLS=n
CONFIG_NETFILTER=n
CONFIG_NETDEVICES=n
CONFIG_ETHERNET=n
CONFIG_VIRTIO_NET=n
CONFIG_ETHTOOL_NETLINK=n
CONFIG_NET_VENDOR_INTEL=n
CONFIG_NET_VENDOR_REALTEK=n
CONFIG_NET_VENDOR_BROADCOM=n
CONFIG_NET_VENDOR_MARVELL=n
CONFIG_NET_VENDOR_MICROCHIP=n
CONFIG_NET_VENDOR_NVIDIA=n
CONFIG_NET_VENDOR_AMD=n
CONFIG_NET_VENDOR_QUALCOMM=n
CONFIG_NET_VENDOR_SAMSUNG=n
CONFIG_NET_VENDOR_STMICRO=n
CONFIG_NET_VENDOR_TI=n
CONFIG_NET_VENDOR_WANGXUN=n
CONFIG_WIRELESS=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_WLAN=n
CONFIG_RFKILL=n
CONFIG_FW_LOADER=n
CONFIG_FW_LOADER_USER_HELPER=n

# VM guest paravirt / hypervisor drivers are not needed for a plain QEMU pc
# guest and cost footprint; keep them out.
CONFIG_HYPERVISOR_GUEST=n
CONFIG_PARAVIRT=n
CONFIG_KVM_GUEST=n
CONFIG_XEN=n
CONFIG_VIRTUALIZATION=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_STAGING=n
CONFIG_IOMMU_SUPPORT=n
CONFIG_VFIO=n
CONFIG_VHOST=n
