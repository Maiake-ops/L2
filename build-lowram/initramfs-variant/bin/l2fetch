#!/bin/sh
# l2fetch - tiny system fetch for L2 and any Linux machine.
#
# POSIX sh only, no awk/jq/python, reads /proc directly.  It is deliberately
# small enough to live in the L2 initramfs and runs on every distribution.

APP_VERSION="0.1.0"
USE_COLOR=1
USE_LOGO=1
case "${NO_COLOR:-}" in ?*) USE_COLOR=0 ;; esac
[ -t 1 ] || USE_COLOR=0

for arg in "$@"; do
    case "$arg" in
        --no-color) USE_COLOR=0 ;;
        --no-logo)  USE_LOGO=0 ;;
        --version)  echo "l2fetch $APP_VERSION"; exit 0 ;;
        -h|--help)
            cat <<'EOF'
usage: l2fetch [--no-color] [--no-logo]

Prints OS, kernel, uptime, packages, shell, CPU, memory and L2 store usage.
No dependencies beyond /bin/sh and /proc.
EOF
            exit 0 ;;
        *) echo "l2fetch: unknown option: $arg" >&2; exit 2 ;;
    esac
done

if [ "$USE_COLOR" = 1 ]; then
    C1='\033[38;5;117m'   # L2 blue
    C2='\033[38;5;212m'   # accent
    C3='\033[38;5;245m'   # label
    C0='\033[0m'
    B='\033[1m'
else
    C1= C2= C3= C0= B=
fi

count_lines() {
    _n=0
    while IFS= read -r _line; do _n=$((_n + 1)); done
    printf '%s' "$_n"
}

# ---------------------------------------------------------------- identity
os_name="Linux"
os_ver=""
[ -r /etc/os-release ] && . /etc/os-release
[ -n "${PRETTY_NAME:-}" ] && os_name=$PRETTY_NAME
[ -z "${PRETTY_NAME:-}" ] && [ -n "${NAME:-}" ] && os_name=$NAME
[ -n "${VERSION_ID:-}" ] && os_ver=$VERSION_ID

kernel=$(cat /proc/sys/kernel/osrelease 2>/dev/null || uname -r 2>/dev/null || echo unknown)
machine=$(uname -m 2>/dev/null || arch 2>/dev/null || echo unknown)
host=$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo l2)
user=${USER:-${LOGNAME:-root}}
shell=${SHELL:-/bin/sh}
term=${TERM:-dumb}
init="unknown"
if [ -r /etc/rcl2.conf ]; then
    init="rcl2"
elif [ -r /proc/1/comm ]; then
    init=$(cat /proc/1/comm 2>/dev/null)
fi

# ---------------------------------------------------------------- uptime
up=""
if [ -r /proc/uptime ]; then
    read -r up_s _ < /proc/uptime
    up_s=${up_s%%.*}
    d=$((up_s / 86400))
    h=$(((up_s % 86400) / 3600))
    m=$(((up_s % 3600) / 60))
    if [ "$d" -gt 0 ]; then up="${d}d ${h}h ${m}m"
    elif [ "$h" -gt 0 ]; then up="${h}h ${m}m"
    else up="${m}m"
    fi
fi

# ---------------------------------------------------------------- memory
mem=""
if [ -r /proc/meminfo ]; then
    mt= ma=0
    while read -r key val _; do
        case "$key" in
            MemTotal:)     mt=$val ;;
            MemAvailable:) ma=$val ;;
        esac
        [ -n "$mt" ] && [ "$ma" != 0 ] && break
    done < /proc/meminfo
    if [ -n "$mt" ] && [ "$mt" -gt 0 ] 2>/dev/null; then
        used=$((mt - ma))
        mem="$((used / 1024)) MiB / $((mt / 1024)) MiB"
    fi
fi

# ---------------------------------------------------------------- cpu
cpu=""
cores=0
if [ -r /proc/cpuinfo ]; then
    while IFS= read -r _line; do
        case "$_line" in
            *"model name"*)
                [ -z "$cpu" ] && { cpu=${_line#*:}; cpu=${cpu# }; cpu=${cpu%"${cpu##*[![:space:]]}"}; }
                ;;
            processor*)
                cores=$((cores + 1))
                ;;
        esac
    done < /proc/cpuinfo
fi
[ -z "$cpu" ] && cpu=$machine
[ "$cores" -gt 0 ] 2>/dev/null && cpu="$cpu ($cores)"

# ---------------------------------------------------------------- packages
pkgs=""
if command -v l2pm >/dev/null 2>&1; then
    n=$(l2pm list 2>/dev/null | count_lines)
    pkgs="$n (l2pm)"
elif command -v dpkg-query >/dev/null 2>&1; then
    n=$(dpkg-query -W -f='.\n' 2>/dev/null | count_lines)
    pkgs="$n (dpkg)"
elif command -v pacman >/dev/null 2>&1; then
    n=$(pacman -Q 2>/dev/null | count_lines)
    pkgs="$n (pacman)"
elif command -v rpm >/dev/null 2>&1; then
    n=$(rpm -qa 2>/dev/null | count_lines)
    pkgs="$n (rpm)"
fi

# ---------------------------------------------------------------- L2 bits
store=""
if [ -d /l2/store ]; then
    n=0
    for d in /l2/store/*; do [ -e "$d" ] && n=$((n + 1)); done
    store="$n path(s)"
fi
l2ver=""
[ -r /etc/l2/version ] && l2ver=$(cat /etc/l2/version 2>/dev/null)

trim() {
    # shell-only leading/trailing space trim
    s=$1
    s=${s#"${s%%[![:space:]]*}"}
    s=${s%"${s##*[![:space:]]}"}
    printf '%s' "$s"
}

print_row() {
    label=$1
    value=$2
    [ -n "$value" ] || return 0
    printf "  ${C3}%-10s${C0} %s\n" "$label" "$(trim "$value")"
}

if [ "$USE_LOGO" = 1 ]; then
    printf '\n%s' "$C1"
    printf '%s\n' '::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::---:::::::::::::::::::::::::::::::::::::::::::--======--::::::::::::::::::::::::
:::::::::::::::::-===++=-:::::::::::::::::::::::::::::::::::::-===+==+++++=+=-::::::::::::::::::::::
:::::::::::::::::-======-:::::::::::::::::::::::::::::::::::-=================-:::::::::::::::::::::
::::::::::::::::::==+++==:::::::::::::::::::::::::::::::::-=++++++++++++++++++==::::::::::::::::::::
::::::::::::::::::-======::::::::::::::::::::::::::::::::-=========-::-========--:::::::::::::::::::
::::::::::::::::::-======-::::::::::::::::::::::::::::::-========-:::::-========-:::::::::::::::::::
:::::::::::::::::::======-:::::::::::::::::::::::::::::-========-:::::::========-:::::::::::::::::::
:::::::::::::::::::--=====-::::::::::::::::::::::::::::--======-::::::::=======-::::::::::::::::::::
:::::::::::::::::::-=+++==-:::::::::::::::::::::::::::-=++++++=-::::::-==+++++=-::::::::::::::::::::
::::::::::::::::::::======-:::::::::::::::::::::::::::-=======-:::::::-=======-:::::::::::::::::::::
::::::::::::::::::::-======-:::::::::::::::::::::::::::::::::::::::::-========::::::::::::::::::::::
::::::::::::::::::::-=++++=-::::::::::::::::::::::::::::::::::::::::-+++++++=-::::::::::::::::::::::
::::::::::::::::::::-======-:::::::::::::::::::::::::::::::::::::::-========-:::::::::::::::::::::::
:::::::::::::::::::-====+===::::::::::::::::::::::::::-=====-:::::-=====+==-::::::::::::::::::::::::
::::::::::::::::::-=========-::::::::::::::::::::::::-======-::::-========-:::::::::::::::::::::::::
:::::::::::::::::-==========-:::::::::::::::::::::::-======-::::-========-:::::::-==-:::::::::::::::
:::::::::::::::-=============-::::::::::::::::::::-=======-::::-========--:--========-::::::::::::::
::::::::::::::-======--======-:::::::::::::::::::-======-:::::-=========-============-::::::::::::::
::::::::::::::::-===-:-=++++=-:::::::::::::::::-=+++++==:::::==++++++++++++++++++++=-:::::::::::::::
:::::::::::::::::::::::-======:::::::::::::::::=======-:::::-====================-::::::::::::::::::
:::::::::::::::::::::::-======-::::::::::::::-=======::::::-================--::::::::::::::::::::::
:::::::::::::::::::::::-==+++=-:::::::::::::-=+++++==--::::==++++++==+==--::::::::::::::::::::::::::
::::::::::::::::::::::::-======:::::::::::--============--:-========-:::::::::::::::::::::::::::::::
::::::::::::::::::::::::-=======---============================---::::::::::::::::::::::::::::::::::
:::::::::::::::::::::::::=======================-----======--:::::::::::::::::::::::::::::::::::::::
:::::::::::::::::::::::::-=============-:-======-::::-======-:::::::::::::::::::::::::::::::::::::::
:::::::::::::::::::::::::--------:::::::::==++++=-:::==++++=-:::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::--===============-::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::===++=++++++==::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::--======-:::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::'
    printf '%s\n' "$C0"
    printf '%s@%s\n' "$user" "$host"
    printf 'L2 - Linux for tools\n\n'
else
    printf '\n%s@%s\n\n' "$user" "$host"
fi

print_row "OS"       "$os_name"
print_row "Kernel"   "$kernel"
print_row "Uptime"   "$up"
print_row "Packages" "$pkgs"
print_row "Shell"    "$shell"
print_row "Terminal" "$term"
print_row "CPU"      "$cpu"
print_row "Memory"   "$mem"
print_row "Init"     "$init"
print_row "L2"       "$l2ver${l2ver:+ }${store:+store: $store}"
[ -n "$L2_ISO_BUDGET" ] && print_row "ISO" "$L2_ISO_BUDGET"
printf '\n'