#!/bin/dash
# A local framebuffer X session. Fail back to tty1 instead of a restart loop.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin HOME=/root SHELL=/bin/dash
[ -s /etc/l2/desktop-user ] || /bin/l2user || exit 1
read -r desktop_user < /etc/l2/desktop-user
case " $(cat /proc/cmdline) " in
    *" l2.desktop=0 "*) exec /bin/login ;;
esac
. /etc/l2/desktop-runtime.sh
export XAPPLRESDIR DISPLAY=:0
mkdir -p /run/l2-desktop /tmp/.X11-unix /root
chmod 1777 /tmp /tmp/.X11-unix
rm -f /run/l2-desktop/display
rm -rf /run/l2-desktop/user
mkdir /run/l2-desktop/user
chown "$desktop_user:$desktop_user" /run/l2-desktop/user
export XAUTHORITY=/run/l2-desktop/Xauthority
rm -f "$XAUTHORITY"
cookie=$(hexdump -n 16 -v -e '1/1 "%02x"' /dev/urandom)
(umask 077; "$L2_XAUTH" -f "$XAUTHORITY" add :0 . "$cookie") || exit 1
unset cookie
chown "$desktop_user:$desktop_user" "$XAUTHORITY"

# Wait briefly for USB input to enumerate, then configure evdev devices.
sleep 2
conf=/run/l2-desktop/xorg.conf
cat > "$conf" <<'EOF'
Section "ServerFlags"
    Option "AutoAddDevices" "false"
    Option "AutoAddGPU" "false"
    Option "AllowEmptyInput" "true"
EndSection
Section "Module"
    Disable "glx"
    Load "fbdevhw"
    Load "shadow"
EndSection
Section "Device"
    Identifier "Framebuffer"
    Driver "fbdev"
    Option "fbdev" "/dev/fb0"
EndSection
Section "Screen"
    Identifier "Screen"
    Device "Framebuffer"
EndSection
EOF
keyboard=0 pointer=0
inputs=/run/l2-desktop/inputs
: > "$inputs"
for event in /sys/class/input/event*; do
    [ -r "$event/device/capabilities/ev" ] || continue
    read -r ev < "$event/device/capabilities/ev"
    key=0
    if [ -r "$event/device/capabilities/key" ]; then
        for word in $(cat "$event/device/capabilities/key"); do key=$word; done
    fi
    case "$ev" in ''|*[!0-9a-fA-F]*) ev=0 ;; esac
    case "$key" in ''|*[!0-9a-fA-F]*) key=0 ;; esac
    kind=
    # KEY_A is bit 30 in the lowest word; EV_REL/EV_ABS mark pointers.
    if [ "$((0x$key & 0x40000000))" -ne 0 ]; then kind=Keyboard
    elif [ "$((0x$ev & 12))" -ne 0 ]; then kind=Pointer
    else continue
    fi
    name=${event##*/}
    cat >> "$conf" <<EOF
Section "InputDevice"
    Identifier "$name"
    Driver "evdev"
    Option "Device" "/dev/input/$name"
    Option "XkbLayout" "us"
EndSection
EOF
    role=SendCoreEvents
    if [ "$kind" = Keyboard ] && [ "$keyboard" = 0 ]; then role=CoreKeyboard; keyboard=1; fi
    if [ "$kind" = Pointer ] && [ "$pointer" = 0 ]; then role=CorePointer; pointer=1; fi
    printf '    InputDevice "%s" "%s"\n' "$name" "$role" >> "$inputs"
done
{
    printf 'Section "ServerLayout"\n    Identifier "Desktop"\n    Screen "Screen"\n'
    cat "$inputs"
    printf 'EndSection\n'
} >> "$conf"

server= session=
cleanup() {
    trap '' HUP INT TERM
    [ -z "$session" ] || kill "$session" 2>/dev/null
    [ -z "$server" ] || kill "$server" 2>/dev/null
    [ -z "$server" ] || wait "$server" 2>/dev/null
}
trap 'cleanup; exit 0' HUP INT TERM
if [ -c /dev/fb0 ]; then
    # Authenticate on the visible text console before X takes the framebuffer.
    export L2_DESKTOP_LOGIN=1
    echo 'Log in to start l2wm. Ctrl+Alt+F2 opens another login console.'
    /bin/login -p "$desktop_user" < /dev/tty1 & session=$!
    while kill -0 "$session" 2>/dev/null && [ ! -f /run/l2-desktop/user/authenticated ]; do sleep 1; done
    if [ ! -f /run/l2-desktop/user/authenticated ]; then
        cleanup
        exit 0
    fi
    # -displayfd signals readiness after keyboard maps and screens exist.
    "$L2_XORG" :0 vt7 -nolisten tcp -noreset -auth "$XAUTHORITY" -config "$conf" \
        -configdir /run/l2-desktop -modulepath "$L2_XMODULES" \
        -fp /opt/l2-desktop/fonts -logfile /run/l2-desktop/Xorg.log \
        -displayfd 3 3>/run/l2-desktop/display > /run/l2-desktop/server.log 2>&1 &
    server=$!
    n=0
    while [ ! -s /run/l2-desktop/display ] && kill -0 "$server" 2>/dev/null && [ "$n" -lt 30 ]; do
        sleep 1; n=$((n + 1))
    done
    if [ -s /run/l2-desktop/display ] && kill -0 "$server" 2>/dev/null; then
        wait "$session"
        unset L2_DESKTOP_LOGIN
        cleanup
        chvt 1 2>/dev/null || true
        exit 0
    else
        echo 'l2desktop: X startup failed; see /run/l2-desktop/Xorg.log'
    fi
else
    echo 'l2desktop: no /dev/fb0; using the text console'
fi
cleanup
unset L2_DESKTOP_LOGIN
chvt 1 2>/dev/null || true
exec /bin/login
