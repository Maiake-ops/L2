#!/bin/dash
# Runs after password authentication, with the desktop owner's uid.
. /etc/l2/desktop-runtime.sh
export XAPPLRESDIR DISPLAY=:0 XAUTHORITY=/run/l2-desktop/Xauthority SHELL=/bin/dash
wm= terminal=
cleanup() {
    trap '' HUP INT TERM
    [ -z "$terminal" ] || kill "$terminal" 2>/dev/null
    [ -z "$wm" ] || kill "$wm" 2>/dev/null
}
trap 'cleanup; exit 0' HUP INT TERM
cd "$HOME" || exit 1
touch /run/l2-desktop/user/authenticated
n=0
while [ ! -s /run/l2-desktop/display ] && [ "$n" -lt 45 ]; do sleep 1; n=$((n + 1)); done
[ -s /run/l2-desktop/display ] || { echo 'X server did not start.'; exit 1; }
l2wm > /run/l2-desktop/user/wm.log 2>&1 & wm=$!
xterm -title 'L2 terminal' > /run/l2-desktop/user/xterm.log 2>&1 & terminal=$!
touch /run/l2-desktop/user/session-ready
wait "$wm"
cleanup
