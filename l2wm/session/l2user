#!/bin/dash
# Set up the desktop owner locally. Passwords go directly to passwd's tty.
set -eu
[ "$(id -u)" = 0 ] || { echo 'l2user: run as root'; exit 1; }
if [ -s /etc/l2/desktop-user ]; then
    echo 'Desktop account already configured. Use adduser or passwd to manage accounts.'
    exit 0
fi
echo
echo 'Welcome to L2. Create your desktop account.'
while :; do
    printf 'Username: '
    IFS= read -r name || exit 1
    case "$name" in
        ''|[!a-z_]*|*[!a-z0-9_-]*|root) echo 'Use a lowercase name starting with a letter or underscore.'; continue ;;
    esac
    [ "${#name}" -le 32 ] || { echo 'Use at most 32 characters.'; continue; }
    if id "$name" >/dev/null 2>&1; then
        [ "$(id -u "$name")" -ge 1000 ] || { echo 'That name belongs to a system account.'; continue; }
    else
        adduser -D -s /bin/dash "$name" || continue
    fi
    [ "$(id -u "$name")" -ge 1000 ] || { echo 'Account must have a regular user ID.'; exit 1; }
    chown "$name:$name" "/home/$name" || { echo 'Account group was not created.'; exit 1; }
    echo 'Set a password (typing is hidden).'
    if passwd -a sha512 "$name"; then
        echo 'Set an administrator (root) password for su and system installation.'
        until passwd -a sha512 root; do echo 'Administrator password was not set. Try again.'; done
        umask 077
        printf '%s\n' "$name" > /etc/l2/desktop-user
        echo 'Account created. Log in to start your desktop.'
        break
    fi
    echo 'Password was not set. Try again.'
done
