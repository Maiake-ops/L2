# --------------------------------------------------------------- l2pm
build_l2pm() {
    init_epoch
    local cc log=$LOGS/l2pm.log
    cc=$(musl_cc)
    job_begin "Building l2pm (static, -Os)" "$log"
    if ! (
        "$cc" -std=c11 -Os -static -ffunction-sections -fdata-sections -Wl,--gc-sections -Wall -Wextra \
            -ffile-prefix-map="$L2_ROOT/l2pm=/l2/src/l2pm" \
            -fdebug-prefix-map="$L2_ROOT/l2pm=/l2/src/l2pm" \
            -o "$OUT/l2pm" "$L2_ROOT/l2pm/l2pm.c"
        strip -s "$OUT/l2pm" 2>/dev/null || true
    ) >"$log" 2>&1; then
        job_end 1; ui_logtail "$log" 60
        die "l2pm build failed (log: $log)"
    fi
    job_end 0
    local size; size=$(stat -c%s "$OUT/l2pm")
    [ "$size" -lt $((10 * 1024 * 1024)) ] || die "l2pm exceeds the 10 MiB storage budget"
    local sel; sel=$(L2PM_ROOT="$BUILD/pmroot" "$OUT/l2pm" selftest 2>&1) || {
        printf '%s\n' "$sel" >&2; die "l2pm selftest failed"
    }
    local rss; rss=$(printf '%s\n' "$sel" | sed -n 's/^rss: \([0-9]*\) KiB.*/\1/p')
    if [ -n "$rss" ] && [ "$rss" -gt 10240 ]; then
        die "l2pm resident memory ${rss} KiB exceeds 10 MiB"
    fi
    say "l2pm: $size bytes, self-test RSS ${rss:-?} KiB"
}

# --------------------------------------------------------------- source helper
# Pin-on-first-use for sources.lock entries that have no upstream hash list:
# the first download records the sha256, every later build verifies it.
fetch_src() {   # name url dest
    local name=$1 url=$2 dest=$3 sha
    sha=$(lock_get "${name}_sha256" || true)
    download "$url" "$dest" "$sha" "$name source"
    if [ -z "$sha" ]; then
        sha=$(sha256_of "$dest")
        lock_set "${name}_sha256" "$sha"
        warn "pinned ${name} sha256 on first download: $sha (compare with upstream once)"
    fi
}

unpack_src() {  # tarball dir-name
    local d=$SRC/$2
    rm -rf "$d"; mkdir -p "$SRC"
    tar -xf "$1" -C "$SRC"
    printf '%s' "$d"
}

# --------------------------------------------------------------- busybox
# busybox is the L2 toolset: every core utility plus DHCP, ip, module tools,
# mount and fdisk.  dash is /bin/sh; busybox's own shells stay off.
# Symbol names are busybox 1.36.1's (arch=BB_ARCH, egrep/fgrep are applets,
# fractional sleep=FEATURE_FANCY_SLEEP; there is no vmstat applet).
BB_APPLETS="AWK BASENAME BB_ARCH BLKID CAL CAT CHGRP CHMOD CHOWN CHROOT CLEAR CMP COMM CP CPIO CUT
    DATE DD DEPMOD DF DIRNAME DMESG DU ECHO EGREP ENV EXPAND EXPR FACTOR FALSE FDISK FGREP FIND
    FOLD FREE GREP GUNZIP GZIP HEAD HEXDUMP HOSTNAME ID INSMOD INSTALL IP KILL KILLALL LESS LINK
    LN LS LSMOD MD5SUM MKDIR MKFIFO MKNOD MKTEMP MODPROBE MORE MOUNT MV NICE NOHUP OD PASTE PIDOF
    PRINTF PS PWD READLINK REALPATH RENICE RM RMDIR RMMOD SED SEQ SHA1SUM SHA256SUM SHA512SUM
    SHUF SLEEP SORT STAT STTY SYNC TAIL TAR TEE TEST TIME TIMEOUT TOP TOUCH TR TRUE TTY UMOUNT
    UNAME UNEXPAND UNIQ UPTIME VI W WATCH WC WHICH WHOAMI XARGS XXD YES ZCAT
    UDHCPC ADDUSER ADDGROUP PASSWD SU LOGIN GETTY CHVT SETSID CTTYHACK
    FEATURE_IP_ADDRESS FEATURE_IP_LINK FEATURE_IP_ROUTE
    FEATURE_MODUTILS_ALIAS FEATURE_MOUNT_FLAGS FEATURE_MOUNT_FSTAB FEATURE_MOUNT_LOOP
    FEATURE_FDISK_WRITABLE FEATURE_FANCY_SLEEP FEATURE_GREP_CONTEXT FEATURE_UTMP
    FEATURE_PS_WIDE FEATURE_PS_LONG FEATURE_TOP_CPU_USAGE_PERCENTAGE FEATURE_SEAMLESS_GZ FEATURE_SEAMLESS_XZ
    FEATURE_TAR_CREATE FEATURE_TAR_AUTODETECT"
build_busybox() {
    init_epoch; build_headers
    local ver url dir log cc a
    ver=$(lock_get busybox_version || true); [ -n "$ver" ] || ver=1.36.1
    url=$(lock_get busybox_source || true); [ -n "$url" ] || url=https://busybox.net/downloads/busybox-$ver.tar.bz2
    fetch_src busybox "$url" "$CACHE/busybox-$ver.tar.bz2"
    dir=$(unpack_src "$CACHE/busybox-$ver.tar.bz2" "busybox-$ver")
    log=$LOGS/busybox.log; cc=$(with_musl)
    job_begin "Building busybox $ver (core toolset + udhcpc ip modprobe mount fdisk)" "$log"
    if ! (
        cd "$dir"
        # Skip finit_module on compressed modules (.ko.xz/.ko.gz) so the kernel
        # does not log "Invalid ELF header magic" before userland decompression.
        sed -i 's#int fd = open(filename, O_RDONLY | O_CLOEXEC);#int fd = is_suffixed_with(filename, ".ko") ? open(filename, O_RDONLY | O_CLOEXEC) : -1;#' modutils/modutils.c
        grep -q 'is_suffixed_with(filename, ".ko")' modutils/modutils.c || { echo "busybox: modutils.c finit_module patch did not match" >&2; exit 1; }
        make allnoconfig
        # busybox kconfig IGNORES duplicate assignments, so appending over the
        # allnoconfig lines silently loses them.  Replace each line in place;
        # only symbols absent from .config are appended.
        while IFS= read -r line; do
            sym=${line%%=*}
            if grep -q "^$sym=" .config; then
                sed -i "s|^$sym=.*|$line|" .config
            elif grep -q "^# $sym is not set" .config; then
                sed -i "s|^# $sym is not set|$line|" .config
            else
                printf '%s\n' "$line" >> .config
            fi
        done <<CFG
CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_VERBOSE_USAGE=n
CONFIG_SH_IS_NONE=y
CONFIG_SH_IS_ASH=n
CONFIG_SH_IS_HUSH=n
CONFIG_FEATURE_SUID=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
CONFIG_LAST_ID=60000
CONFIG_FIRST_SYSTEM_ID=100
CONFIG_LAST_SYSTEM_ID=999
CONFIG_DEFAULT_MODULES_DIR="/lib/modules"
CONFIG_DEFAULT_DEPMOD_FILE="modules.dep"
CONFIG_FEATURE_LESS_MAXLINES=9999999
CONFIG_UDHCPC_DEFAULT_SCRIPT="/etc/l2/udhcpc.script"
CONFIG_UDHCPC_DEFAULT_INTERFACE="eth0"
CONFIG_UNAME_OSNAME="GNU/Linux"
$(for a in $BB_APPLETS; do printf 'CONFIG_%s=y\n' "$a"; done)
CFG
        yes "" | make oldconfig >/dev/null
        missing=""
        for a in $BB_APPLETS; do
            grep -q "^CONFIG_$a=y" .config || missing="$missing $a"
        done
        [ -z "$missing" ] || { echo "busybox: dropped by oldconfig:$missing" >&2; exit 1; }
        grep -q '^CONFIG_DEFAULT_MODULES_DIR="/lib/modules"' .config || { echo "busybox: DEFAULT_MODULES_DIR lost" >&2; exit 1; }
        make -j"$JOBS" -l"$LOAD" CC="$cc" HOSTCC="${HOST_CC:-cc}" SKIP_STRIP=y \
            EXTRA_CFLAGS="-Os -ffile-prefix-map=$PWD=." LDFLAGS=-static busybox
    ) >"$log" 2>&1; then job_end 1; ui_logtail "$log" 60; die "busybox build failed (log: $log)"; fi
    install -m 0755 "$dir/busybox" "$OUT/busybox"
    have strip && strip -s "$OUT/busybox" 2>/dev/null || true
    "$OUT/busybox" --list > "$OUT/busybox.applets" 2>/dev/null || true
    # the toolset must actually be in the binary, not just in .config
    for a in ls cat cp mv rm mkdir grep sed awk find mount udhcpc ip modprobe fdisk blkid vi less tar cpio; do
        grep -qx "$a" "$OUT/busybox.applets" || die "busybox binary is missing the '$a' applet"
    done
    job_end 0 "$(ui_size "$(stat -c%s "$OUT/busybox")")"
}

