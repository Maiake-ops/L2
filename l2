# --------------------------------------------------------------- openssl
# Size-trimmed static OpenSSL (musl, no shared libs, no legacy/engines/DTLS/
# SSLv3/old ciphers/CMS/OCSP/...).  It is NOT put in the RAM-resident initramfs:
# the finished pack (build/ssl) rides on the boot medium (l2/ssl) like the wifi
# pack, and /bin/openssl (a 600-byte dash launcher) runs it from there, so idle
# RAM does not change.  On an installed disk the pack is copied onto the root.
#   L2_SSL=core|wifi|off     where the pack goes on the ISOs   (default core)
#   L2_SSL_EMBED=1           put it in the initramfs too (costs RAM = binary size)
#   L2_OPENSSL_ASM=1         enable x86_64 asm (AES-NI/SHA; faster, ~+150 KiB)
#   L2_SSL_CA=1|/path.pem    ship a CA bundle (host bundle, or the given file)
# Options that a given OpenSSL version does not know are skipped, not fatal.
# NOTE: the legacy provider + old ciphers/digests (md4/rc4/des/...) stay ENABLED:
# wpa_supplicant's crypto_openssl.c references them (SAE/WPA3 build), even though
# WPA2/WPA3-PSK itself only uses AES/SHA/HMAC/ECC.  They live on the medium, not
# in RAM, so they do not cost idle memory.
OPENSSL_NO="shared dso engine comp ssl3 ssl3-method tls1 tls1-method tls1_1 tls1_1-method
    dtls dtls1 dtls1-method dtls1_2 dtls1_2-method weak-ssl-ciphers deprecated tests docs afalgeng
    async threads srp psk ocsp cms ct ts srtp sctp rfc3779 nextprotoneg ec2m
    camellia seed aria sm2 sm3 sm4 whirlpool rmd160 siphash blake2 ocb siv quic
    ktls uplink cmp crmf trace ssl-trace secure-memory tfo unit-test fuzz-afl fuzz-libfuzzer
    external-tests acvp-tests buildtest-c++ ec_nistp_64_gcc_128"
build_openssl() {
    init_epoch; build_headers
    # Idempotent: wpa_supplicant also builds against this, so do not rebuild if
    # the binary and the sysroot dev files are already present.
    if [ -x "$OUT/openssl" ] && [ -f "$SYSROOT/lib/libcrypto.a" ] && [ "${1:-}" != "--force" ]; then
        say "openssl: already built; skipping (rm $OUT/openssl to rebuild)"
        return 0
    fi
    local ver url dir log cc o opts="" sha up ca
    ver=${OPENSSL_VERSION:-$(lock_get openssl_version || true)}; [ -n "$ver" ] || ver=3.5.4
    url=$(lock_get openssl_source || true)
    [ -n "$url" ] || url=https://github.com/openssl/openssl/releases/download/openssl-$ver/openssl-$ver.tar.gz
    # upstream publishes <tarball>.sha256: use it as the pin on first download
    if [ -z "$(lock_get openssl_sha256 || true)" ] && have curl; then
        up=$(curl -fsSL --max-time 30 "$url.sha256" 2>/dev/null | awk 'NR==1 { print $1 }' || true)
        if [ "${#up}" -eq 64 ]; then lock_set openssl_sha256 "$up"; fi
    fi
    fetch_src openssl "$url" "$CACHE/openssl-$ver.tar.gz"
    dir=$(unpack_src "$CACHE/openssl-$ver.tar.gz" "openssl-$ver")
    log=$LOGS/openssl.log; cc=$(with_musl)
    have perl || die "perl is required to configure OpenSSL (l2 deps install)"
    # Only pass no-<feature> options this release can actually disable.
    # Configure's @disablables list plus the tls/dtls protocol variants it adds
    # at runtime is authoritative; a loose grep also matches internal-only
    # aliases (e.g. crmf) and makes Configure die with "Unsupported options".
    local disablables p
    disablables=$(awk '/^my @disablables = \(/,/^[ \t]*\);/' "$dir/Configure" \
        | grep -o '"[^"]*"' | tr -d '"')
    for p in $(sed -n 's/^my @tls = qw(\(.*\));/\1/p;s/^my @dtls = qw(\(.*\));/\1/p' "$dir/Configure"); do
        disablables="$disablables
$p"
        [ "$p" = tls1_3 ] || disablables="$disablables
$p-method"
    done
    for o in $OPENSSL_NO; do
        printf '%s\n' "$disablables" | grep -qx "$o" && opts="$opts no-$o"
    done
    [ "${L2_OPENSSL_ASM:-0}" = 1 ] || opts="$opts no-asm"
    job_begin "Building openssl $ver (static, trimmed, -Os)" "$log"
    if ! (
        cd "$dir"
        CC="$cc" ./Configure linux-x86_64 --prefix=/usr --openssldir=/etc/ssl --libdir=lib $opts \
            -static -Os -ffunction-sections -fdata-sections -Wl,--gc-sections \
            -ffile-prefix-map="$PWD"=. -fdebug-prefix-map="$PWD"=.
        make -j"$JOBS" -l"$LOAD" build_sw
    ) >"$log" 2>&1; then job_end 1; ui_logtail "$log" 60; die "openssl build failed (log: $log)"; fi
    [ -x "$dir/apps/openssl" ] || die "openssl binary missing after build (log: $log)"
    install -m 0755 "$dir/apps/openssl" "$OUT/openssl"
    have strip && strip -s "$OUT/openssl" 2>/dev/null || true
    # Install the dev files (headers + static libs) into the sysroot so other
    # components can build against this OpenSSL.  wpa_supplicant's SAE/WPA3
    # needs OpenSSL's crypto_bignum API, which the internal crypto lacks.
    mkdir -p "$SYSROOT/include" "$SYSROOT/lib"
    cp -a "$dir/include/openssl" "$SYSROOT/include/"
    install -m 0644 "$dir/libcrypto.a" "$dir/libssl.a" "$SYSROOT/lib/"
    # pack layout == layout on the ISO (l2/ssl) and on an installed root
    local w=$BUILD/ssl
    rm -rf "$w"; mkdir -p "$w/bin" "$w/etc/ssl"
    install -m 0755 "$OUT/openssl" "$w/bin/openssl"
    install -m 0644 "$L2_ROOT/config/openssl.cnf" "$w/etc/ssl/openssl.cnf"
    ca=${L2_SSL_CA:-0}
    case "$ca" in
        0|'') ;;
        1) ca=/etc/ssl/certs/ca-certificates.crt
           [ -r "$ca" ] || ca=/etc/ssl/cert.pem ;;
    esac
    if [ "$ca" != 0 ] && [ -n "$ca" ]; then
        if [ -r "$ca" ]; then install -m 0644 "$ca" "$w/etc/ssl/cert.pem"
        else warn "L2_SSL_CA: $ca not readable; shipping no CA bundle"; fi
    fi
    find "$w" -exec touch -h -d "@$EPOCH" {} + 2>/dev/null || true
    job_end 0 "$(ui_size "$(stat -c%s "$OUT/openssl")")"
    say "ssl pack: $(du -sk "$w" | awk '{print $1}') KiB on the medium, 0 KiB resident (run from l2/ssl)"
}

# --------------------------------------------------------------- firmware
# Wi-Fi firmware is selected per family from config/wifi-firmware.list.
#   L2_WIFI_FAMILIES="mt7921 iwlwifi ..."   (default: all)
#   L2_FIRMWARE_SRC=/lib/firmware           use an existing firmware tree
#   L2_FW_COMPRESS=0                        keep files uncompressed
ALL_FAMILIES="core mt7921 iwlwifi rtw88 rtw89 rtlwifi ath9k ath10k ath11k ath12k brcm"
latest_firmware() {
    curl -fsSL --max-time 30 https://cdn.kernel.org/pub/linux/kernel/firmware/ \
        | grep -o 'linux-firmware-[0-9]\{8\}\.tar\.xz' | sort -u | tail -1 \
        | sed 's/^linux-firmware-//; s/\.tar\.xz$//'
}

build_firmware() {
    init_epoch
    local fams=${L2_WIFI_FAMILIES:-$ALL_FAMILIES} src=${L2_FIRMWARE_SRC:-} root dest=$BUILD/firmware log=$LOGS/firmware.log
    case " $fams " in *" core "*) ;; *) fams="core $fams" ;; esac
    if [ -z "$src" ]; then
        local ver; ver=$(lock_get firmware_version || true)
        [ -n "$ver" ] || { ver=$(latest_firmware); [ -n "$ver" ] || die "cannot resolve linux-firmware (set L2_FIRMWARE_SRC=/lib/firmware to use a local tree)"; lock_set firmware_version "$ver"; }
        fetch_src firmware "https://cdn.kernel.org/pub/linux/kernel/firmware/linux-firmware-$ver.tar.xz" \
            "$CACHE/linux-firmware-$ver.tar.xz"
        root=$SRC/linux-firmware-$ver
        if [ ! -d "$root" ]; then
            job_begin "Unpacking linux-firmware $ver (large, one time)" ""
            tar -xf "$CACHE/linux-firmware-$ver.tar.xz" -C "$SRC" || { job_end 1; die "unpack failed"; }
            job_end 0
        fi
    else
        root=$src
        [ -d "$root" ] || die "L2_FIRMWARE_SRC=$root is not a directory"
    fi
    rm -rf "$dest"; mkdir -p "$dest"
    local fam glob f n=0 rel
    shopt -s nullglob
    while IFS='|' read -r fam glob; do
        case "$fam" in ''|'#'*) continue ;; esac
        case " $fams " in *" $fam "*) ;; *) continue ;; esac
        for f in "$root"/$glob "$root"/$glob.xz "$root"/$glob.zst; do
            [ -f "$f" ] || continue
            rel=${f#"$root"/}; mkdir -p "$dest/$(dirname "$rel")"
            cp -L "$f" "$dest/$rel"; n=$((n + 1))
        done
    done < "$L2_ROOT/config/wifi-firmware.list"
    shopt -u nullglob
    # iwlwifi ships many API revisions: keep the two newest per family
    local pref
    for pref in $(cd "$dest" && ls iwlwifi-*.ucode* 2>/dev/null | sed 's/-[0-9]*\.ucode.*$//' | sort -u); do
        ( cd "$dest" && ls "$pref"-[0-9]*.ucode* | sort -V | head -n -2 | xargs -r rm -f )
    done
    # xz-compress (kernel FW_LOADER_COMPRESS_XZ); regulatory.db must stay plain
    if [ "${L2_FW_COMPRESS:-1}" = 1 ] && have xz; then
        find "$dest" -type f ! -name 'regulatory.db*' ! -name '*.xz' ! -name '*.zst' \
            -exec xz --lzma2=preset=9e,dict=256KiB --check=crc32 -f {} + 2>>"$log" || warn "some firmware could not be compressed"
    fi
    find "$dest" -exec touch -h -d "@$EPOCH" {} + 2>/dev/null || true
    [ "$n" -gt 0 ] || warn "no firmware matched in $root (families: $fams)"
    say "firmware: $n files, $(du -sk "$dest" | awk '{print $1}') KiB  ($fams)"
}

# --------------------------------------------------------------- wifi pack
# modules + firmware + wpa tools, laid out exactly as they sit on the ISO
# (l2/wifi) and on an installed root (merge with cp -a).
build_wifipack() {
    init_epoch
    local krel w=$BUILD/wifi
    krel=$(cat "$OUT/kernelrelease" 2>/dev/null) || die "kernel not built (no kernelrelease)"
    [ -d "$BUILD/modroot/lib/modules/$krel" ] || die "no modules built (CONFIG_MODULES?) - run: l2 build kernel"
    rm -rf "$w"; mkdir -p "$w/bin" "$w/lib/modules" "$w/lib/firmware"
    cp -a "$BUILD/modroot/lib/modules/$krel" "$w/lib/modules/"
    if [ "${L2_MOD_COMPRESS:-1}" = 1 ] && have xz && depmod --version 2>/dev/null | grep -q '+XZ'; then
        find "$w/lib/modules/$krel/kernel" -name '*.ko' -exec xz --lzma2=preset=9e,dict=256KiB --check=crc32 -f {} +
        depmod -b "$w" "$krel" || die "depmod failed on wifipack"
    fi
    [ -d "$BUILD/firmware" ] && cp -a "$BUILD/firmware/." "$w/lib/firmware/" || warn "no firmware tree (l2 build firmware): chips that need firmware will not work"
    local b
    for b in wpa_supplicant wpa_cli; do
        [ -x "$OUT/$b" ] && install -m 0755 "$OUT/$b" "$w/bin/$b" || warn "$b missing (l2 build wpa)"
    done
    find "$w" -exec touch -h -d "@$EPOCH" {} + 2>/dev/null || true
    say "wifi pack: $(du -sk "$w" | awk '{print $1}') KiB  (modules + firmware + wpa)"
}

# --------------------------------------------------------------- hw pack
# On-demand hardware drivers (I2C HID touchpads, exFAT, old USB, ACPI video).
# Kept OUT of the RAM-resident initramfs and shipped on the medium (l2/hw) /
# installed root, so they cost nothing at idle.  The wifi pack is a superset.
HW_MODULE_DIRS="drivers/i2c drivers/hid drivers/usb/host drivers/usb/storage drivers/acpi drivers/platform fs/exfat drivers/net/ethernet drivers/net/usb"
build_hwpack() {
    init_epoch
    local krel w=$BUILD/hw d dep
    krel=$(cat "$OUT/kernelrelease" 2>/dev/null) || die "kernel not built (no kernelrelease)"
    [ -d "$BUILD/modroot/lib/modules/$krel" ] || die "no modules built - run: l2 build kernel"
    rm -rf "$w"; mkdir -p "$w/lib/modules/$krel/kernel"
    local msrc=$BUILD/modroot/lib/modules/$krel mdst=$w/lib/modules/$krel
    for d in $HW_MODULE_DIRS; do
        if [ -d "$msrc/kernel/$d" ]; then
            mkdir -p "$mdst/kernel/$(dirname "$d")"
            cp -a "$msrc/kernel/$d" "$mdst/kernel/$d"
        fi
    done
    # Copy transitive dependencies (e.g. libphy/mdio_bus for r8169, mii for usbnet).
    if [ -f "$msrc/modules.dep" ]; then
        while IFS= read -r dep; do
            [ -f "$msrc/$dep" ] || continue
            if [ ! -f "$mdst/$dep" ]; then
                mkdir -p "$mdst/$(dirname "$dep")"
                cp -a "$msrc/$dep" "$mdst/$dep"
            fi
        done < <(awk -F: '
            NR == FNR { have[$0] = 1; q[++qn] = $0; next }
            {
                mod = $1
                sub(/^[ \t]+/, "", $2)
                deps[mod] = $2
            }
            END {
                i = 1
                while (i <= qn) {
                    n = split(deps[q[i]], a, /[ \t]+/)
                    for (j = 1; j <= n; j++) {
                        if (a[j] != "" && !(a[j] in have)) {
                            have[a[j]] = 1
                            q[++qn] = a[j]
                            print a[j]
                        }
                    }
                    i++
                }
            }
        ' <(cd "$mdst" && find kernel -name '*.ko') "$msrc/modules.dep")
    fi
    cp -a "$msrc"/modules.builtin "$msrc"/modules.order "$mdst/" 2>/dev/null || true
    if [ "${L2_MOD_COMPRESS:-1}" = 1 ] && have xz && depmod --version 2>/dev/null | grep -q '+XZ'; then
        find "$mdst/kernel" -name '*.ko' -exec xz --lzma2=preset=9e,dict=256KiB --check=crc32 -f {} +
    fi
    if have depmod; then
        depmod -b "$w" "$krel" || die "depmod failed on hwpack"
    fi
    if [ -f "$mdst/modules.dep" ]; then
        local mod_re
        for mod_re in 'r8169\.ko(\.xz)?:' 'usbnet\.ko(\.xz)?:'; do
            if grep -Eq "$mod_re" "$mdst/modules.dep" && ! grep -Eq "${mod_re}[ \t]*[^ \t]" "$mdst/modules.dep"; then
                die "hwpack modules.dep missing dependencies for $mod_re"
            fi
        done
    fi
    find "$w" -exec touch -h -d "@$EPOCH" {} + 2>/dev/null || true
    say "hw pack: $(du -sk "$w" | awk '{print $1}') KiB  (on-demand hardware drivers)"
}

# --------------------------------------------------------------- install tools
# Tools `l2install disk` needs when it runs INSIDE the booted live system:
# a GPT partitioner, ext4/FAT formatters and the limine BIOS installer.  They
# ship on the boot medium (l2/install) like the hw/ssl packs and cost zero
# idle RAM; l2install puts the pack's bin/ on PATH when it detects the live
# medium.  On a normal host the installer keeps using the host tools.
#
# The partitioner is l2gpt (our own C, sgdisk-compatible CLI): gdisk itself
# is C++ and a static musl build would need a musl-targeted libstdc++ (the
# host one is ABI-bound to glibc locale internals) at ~1 MiB.  l2gpt's GPT
# output is byte-identical to sgdisk's for the layouts L2 creates.

build_l2gpt() {
    init_epoch
    local cc log=$LOGS/l2gpt.log
    cc=$(musl_cc)
    job_begin "Building l2gpt (static C, sgdisk-compatible)" "$log"
    if ! ( "$cc" -std=c11 -Os -static -Wall -Wextra \
            -ffile-prefix-map="$L2_ROOT/l2gpt=/l2/src/l2gpt" \
            -fdebug-prefix-map="$L2_ROOT/l2gpt=/l2/src/l2gpt" \
            -o "$OUT/l2gpt" "$L2_ROOT/l2gpt/l2gpt.c" && strip -s "$OUT/l2gpt" 2>/dev/null; ) >"$log" 2>&1; then
        job_end 1; ui_logtail "$log"; die "l2gpt build failed"
    fi
    job_end 0 "$(ui_size "$(stat -c%s "$OUT/l2gpt")")"
}

build_e2fsprogs() {
    init_epoch; build_headers
    # Idempotent: only mke2fs is needed (as mkfs.ext4 via argv[0]).
    if [ -x "$OUT/mke2fs" ] && [ "${1:-}" != "--force" ]; then
        say "e2fsprogs: already built; skipping (rm $OUT/mke2fs to rebuild)"
        return 0
    fi
    local ver url dir log cc
    ver=$(lock_get e2fsprogs_version || true); [ -n "$ver" ] || ver=1.47.4
    url=$(lock_get e2fsprogs_source || true)
    [ -n "$url" ] || url=https://www.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v$ver/e2fsprogs-$ver.tar.gz
    fetch_src e2fsprogs "$url" "$CACHE/e2fsprogs-$ver.tar.gz"
    dir=$(unpack_src "$CACHE/e2fsprogs-$ver.tar.gz" "e2fsprogs-$ver")
    log=$LOGS/e2fsprogs.log; cc=$(with_musl)
    job_begin "Building e2fsprogs $ver mke2fs (static, trimmed)" "$log"
    if ! (
        cd "$dir"
        ./configure --disable-nls --disable-fuse2fs --disable-uuidd --disable-debugfs \
            --disable-imager --disable-resizer --disable-defrag --disable-tls --disable-mmp \
            --disable-tdb --disable-bmap-stats --without-libarchive \
            CC="$cc" CFLAGS="-Os -ffile-prefix-map=$PWD=." LDFLAGS="-static"
        make -j"$JOBS" -l"$LOAD" libs
        make -j"$JOBS" -l"$LOAD" -C misc mke2fs
    ) >"$log" 2>&1; then job_end 1; ui_logtail "$log" 60; die "e2fsprogs build failed (log: $log)"; fi
    install -m 0755 "$dir/misc/mke2fs" "$OUT/mke2fs"
    have strip && strip -s "$OUT/mke2fs" 2>/dev/null || true
    job_end 0 "$(ui_size "$(stat -c%s "$OUT/mke2fs")")"
}

build_dosfstools() {
    init_epoch
    if [ -x "$OUT/mkfs.fat" ] && [ "${1:-}" != "--force" ]; then
        say "dosfstools: already built; skipping (rm $OUT/mkfs.fat to rebuild)"
        return 0
    fi
    local ver url dir log cc
    ver=$(lock_get dosfstools_version || true); [ -n "$ver" ] || ver=4.2
    url=$(lock_get dosfstools_source || true)
    [ -n "$url" ] || url=https://github.com/dosfstools/dosfstools/releases/download/v$ver/dosfstools-$ver.tar.gz
    fetch_src dosfstools "$url" "$CACHE/dosfstools-$ver.tar.gz"
    dir=$(unpack_src "$CACHE/dosfstools-$ver.tar.gz" "dosfstools-$ver")
    log=$LOGS/dosfstools.log; cc=$(with_musl)
    job_begin "Building dosfstools $ver mkfs.fat (static)" "$log"
    if ! (
        cd "$dir"
        ./configure --without-udev CC="$cc" CFLAGS="-Os -ffile-prefix-map=$PWD=." LDFLAGS="-static"
        make -j"$JOBS" -l"$LOAD" -C src mkfs.fat
    ) >"$log" 2>&1; then job_end 1; ui_logtail "$log" 60; die "dosfstools build failed (log: $log)"; fi
    install -m 0755 "$dir/src/mkfs.fat" "$OUT/mkfs.fat"
    have strip && strip -s "$OUT/mkfs.fat" 2>/dev/null || true
    job_end 0 "$(ui_size "$(stat -c%s "$OUT/mkfs.fat")")"
}

# The pack laid out exactly as it sits on the medium (l2/install).  Besides
# the tools it carries the static limine host tool (the ISO only ships the
# boot sectors, not the installer binary) and the config templates l2install
# substitutes at install time.
build_installpack() {
    init_epoch
    local w=$BUILD/installtools b ver ldir cc
    for b in l2gpt mke2fs mkfs.fat; do
        [ -x "$OUT/$b" ] || die "$OUT/$b missing; run: l2 build l2gpt e2fsprogs dosfstools"
    done
    ver=$(lock_get limine_version || true)
    ldir=$SRC/limine-$ver/bin
    [ -f "$ldir/limine.c" ] || die "limine sources missing; run: l2 build limine"
    rm -rf "$w"; mkdir -p "$w/bin" "$w/etc"
    install -m 0755 "$OUT/l2gpt" "$w/bin/sgdisk"
    install -m 0755 "$OUT/mke2fs" "$w/bin/mke2fs"
    ln -s mke2fs "$w/bin/mkfs.ext4"
    install -m 0755 "$OUT/mkfs.fat" "$w/bin/mkfs.fat"
    ln -s mkfs.fat "$w/bin/mkfs.vfat"
    # static musl build of the limine host tool (the regular one is a host
    # binary and cannot run inside the live system); bin/limine.c is the
    # version-substituted, epoch-seeded source generated by build_limine.
    cc=$(musl_cc)
    "$cc" -std=c99 -Os -static -ffile-prefix-map="$ldir=." -o "$w/bin/limine" "$ldir/limine.c" \
        || die "static limine host tool build failed"
    strip -s "$w/bin/limine" 2>/dev/null || true
    install -m 0644 "$L2_ROOT/config/cmdline" "$w/etc/cmdline"
    install -m 0644 "$L2_ROOT/config/limine-installed.conf" "$w/etc/limine-installed.conf"
    find "$w" -exec touch -h -d "@$EPOCH" {} + 2>/dev/null || true
    say "install pack: $(du -sk "$w" | awk '{print $1}') KiB on the medium, 0 KiB resident (sgdisk mke2fs mkfs.fat limine)"
}

# --------------------------------------------------------------- rootfs
build_rootfs() {
    init_epoch
    local f
    for f in dash rcl2 l2pm busybox l2wifi; do
        [ -f "$OUT/$f" ] || die "$OUT/$f missing; build it first (l2 build $f)"
    done
    step "Assembling rootfs"
    rm -rf "$ROOTFS"
    mkdir -p "$ROOTFS"/{bin,etc,proc,sys,dev,tmp,run,root,boot,media/l2,lib/modules} \
             "$ROOTFS"/usr \
             "$ROOTFS"/l2/{store,var/db/installed,var/profiles,cache,src,recipes,lib} \
             "$ROOTFS"/etc/l2 \
             "$ROOTFS"/l2/var/profiles/default-0-link/{bin,sbin,usr/bin,usr/sbin}
    printf 'profile\n' > "$ROOTFS/l2/var/profiles/default-0-link/.l2pm-profile"
    : > "$ROOTFS/l2/var/profiles/default-0-link/.l2pm-gen"
    ln -s default-0-link "$ROOTFS/l2/var/profiles/default"
    ln -s bin "$ROOTFS/sbin"
    ln -s /l2/var/profiles/default/usr/bin "$ROOTFS/usr/bin"
    ln -s /l2/var/profiles/default/usr/sbin "$ROOTFS/usr/sbin"

    # busybox is the core toolset: symlink every applet it actually contains.
    install -m 0755 "$OUT/busybox" "$ROOTFS/bin/busybox"
    local applets
    applets=$("$OUT/busybox" --list) || die "busybox --list failed"
    [ -n "$applets" ] || die "busybox reports no applets"
    for f in $applets; do
        case "$f" in busybox|sh|init|poweroff|reboot|halt) continue ;; esac
        ln -sf busybox "$ROOTFS/bin/$f"
    done
    # poweroff/reboot/halt talk to rcl2 (PID 1) with the signals it maps to a
    # clean shutdown; busybox's own applets use a different signal mapping.
    install -m 0755 "$L2_ROOT/overlay/bin/shutdown" "$ROOTFS/bin/shutdown"
    for f in poweroff reboot halt; do ln -sf shutdown "$ROOTFS/bin/$f"; done
    install -m 0755 "$OUT/dash" "$ROOTFS/bin/dash"
    ln -sf dash "$ROOTFS/bin/sh"
    install -m 0755 "$OUT/rcl2" "$ROOTFS/bin/rcl2"
    ln -sf bin/rcl2 "$ROOTFS/init"
    install -m 0755 "$OUT/l2pm" "$ROOTFS/bin/l2pm"
    install -m 0755 "$OUT/l2wifi" "$ROOTFS/bin/l2wifi"
    install -m 0755 "$L2_ROOT/l2fetch" "$ROOTFS/bin/l2fetch"
    install -m 0755 "$L2_ROOT/l2install" "$ROOTFS/bin/l2install"
    install -m 0644 "$L2_ROOT/lib/l2ui.sh" "$ROOTFS/l2/lib/l2ui.sh"
    # scripts: l2net, udhcpc handler, serial getty, net.conf
    cp -a "$L2_ROOT/overlay/." "$ROOTFS/"
    # openssl normally stays on the boot medium (zero RAM); embed only on request
    if [ "${L2_SSL_EMBED:-0}" = 1 ]; then
        [ -d "$BUILD/ssl" ] || die "L2_SSL_EMBED=1 but no ssl pack (l2 build openssl)"
        cp -a "$BUILD/ssl/." "$ROOTFS/"
        warn "openssl embedded in the initramfs: costs $(ui_size "$(stat -c%s "$OUT/openssl")") of RAM"
    fi

    install -m 0644 "$L2_ROOT/config/rcl2.conf" "$ROOTFS/etc/rcl2.conf"
    install -m 0644 "$L2_ROOT/config/os-release" "$ROOTFS/etc/os-release"
    printf 'L2 %s\n' "$APP_VERSION" > "$ROOTFS/etc/l2/version"
    # Hardware drivers are NOT put in the RAM-resident initramfs: they ship in
    # the hw pack on the medium / installed root (see build_hwpack), so they
    # cost nothing at idle.  Wifi drivers ship in the wifi pack.
    cat > "$ROOTFS/etc/passwd" <<'PW'
root:x:0:0:root:/root:/bin/dash
PW
    printf 'root:x:0:\n' > "$ROOTFS/etc/group"
    printf 'L2\n' > "$ROOTFS/etc/hostname"
    printf '127.0.0.1 localhost L2\n::1 localhost\n' > "$ROOTFS/etc/hosts"
    cat > "$ROOTFS/etc/profile" <<'PF'
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PS1='L2# '
if [ "$(id -u)" != 0 ]; then PS1='L2$ '; fi
PF
    cat > "$ROOTFS/etc/motd" <<'MT'

  L2 - tiny Linux for tools
  l2wifi         scan and connect to wifi
  l2net status   network state
  l2fetch        system summary
  openssl        TLS/crypto tool (runs from the boot medium)
  l2pm list      installed packages
  l2install -h   install to disk

MT
    cp -a "$L2_ROOT"/l2pm/recipes/*.recipe "$ROOTFS/l2/recipes/" 2>/dev/null || true
    if [ "$(id -u)" -eq 0 ]; then
        mknod -m 600 "$ROOTFS/dev/console" c 5 1 2>/dev/null || true
        mknod -m 666 "$ROOTFS/dev/null" c 1 3 2>/dev/null || true
        mknod -m 666 "$ROOTFS/dev/zero" c 1 5 2>/dev/null || true
    fi
    find "$ROOTFS" -exec touch -h -d "@$EPOCH" {} + 2>/dev/null || true
    say "rootfs: $(du -sk "$ROOTFS" | awk '{print $1}') KiB in $ROOTFS"
}

build_initramfs() {
    local output=${1:-$OUT/initramfs-l2}
    init_epoch
    [ -d "$ROOTFS/bin" ] || die "rootfs missing; run: l2 build rootfs"
    have cpio || die "cpio is required"
    have gzip || die "gzip is required"
    step "Creating gzip initramfs"
    local repro=""
    if cpio --help 2>&1 | grep -q -- '--reproducible'; then repro="--reproducible"; fi
    (
        local tmp; tmp=$(mktemp "$output.XXXXXX")
        trap 'rm -f "$tmp"' EXIT
        cd "$ROOTFS"
        find . -print0 | LC_ALL=C sort -z \
            | cpio --null -o --format=newc --owner=0:0 $repro 2>/dev/null \
            | gzip -9 -n > "$tmp"
        chmod 0644 "$tmp"
        mv -f "$tmp" "$output"
    )
    say "initramfs: $output ($(stat -c%s "$output") bytes)"
}

# --------------------------------------------------------------- limine
build_limine() {
    init_epoch
    local ver sha src_url tarball dir log
    ver=$(lock_get limine_version || true)
    src_url=$(lock_get limine_source || true)
    sha=$(lock_get limine_sha256 || true)
    [ -n "$ver" ] || ver=$(latest_limine)
    [ -n "$ver" ] || die "sources.lock has no limine_version"
    [ -n "$src_url" ] || src_url="https://codeberg.org/Limine/Limine/releases/download/v$ver/limine-$ver.tar.gz"
    tarball=$CACHE/limine-$ver.tar.gz
    download "$src_url" "$tarball" "$sha" "limine $ver source"
    dir=$SRC/limine-$ver
    rm -rf "$dir"
    mkdir -p "$SRC"
    tar -xf "$tarball" -C "$SRC"
    # The host tool seeds the MBR disk ID with time(NULL); use the build epoch
    # so `limine bios-install` does not make the ISO change on every run.
    if [ -f "$dir/host/limine.c" ]; then
        sed -i 's/srand(time(NULL));/srand(getenv("SOURCE_DATE_EPOCH") ? (unsigned)strtoul(getenv("SOURCE_DATE_EPOCH"), NULL, 10) : time(NULL));/' "$dir/host/limine.c"
    fi
    log=$LOGS/limine.log
    local cct
    if have gcc; then cct=$(command -v gcc)
    elif have clang; then cct=$(command -v clang)
    else die "gcc or clang is required to build limine"
    fi
    job_begin "Building limine $ver (BIOS + UEFI, -j$JOBS)" "$log"
    if ! (
        cd "$dir"
        # Release tarballs ship a generated configure; no autotools needed.
        # Limine wants LLVM binutils + ld.lld, and nasm for the BIOS port.
        CC_FOR_TARGET="$cct" ./configure \
            --prefix="$OUT/limine" \
            --enable-bios --enable-bios-cd \
            --enable-uefi-x86-64 --enable-uefi-cd
        make -j"$JOBS" -l"$LOAD"
        make install
    ) >"$log" 2>&1; then
        job_end 1; ui_logtail "$log" 60
        die "limine build failed (log: $log)"
    fi
    job_end 0
    local f
    for f in bin/limine share/limine/limine-bios.sys share/limine/limine-bios-cd.bin \
             share/limine/limine-uefi-cd.bin share/limine/BOOTX64.EFI; do
        [ -f "$OUT/limine/$f" ] || die "limine build produced no $f"
    done
    say "limine: $OUT/limine/bin/limine ($(stat -c%s "$OUT/limine/bin/limine") bytes)"
}

# --------------------------------------------------------------- ISO
cmdline_base() { tr -d '\n' < "$L2_ROOT/config/cmdline" 2>/dev/null || printf 'loglevel=4'; }

# _make_iso OUT LIMIT_MB LABEL WITH_WIFI [INITRAMFS]
_make_iso() {
    local out=$1 limit_mb=$2 label=$3 wifi=$4 initrd=${5:-$OUT/initramfs-l2}
    [ -f "$OUT/vmlinuz-l2" ] || die "kernel missing; run: l2 build kernel"
    [ -f "$initrd" ] || die "$initrd missing; run: l2 build initramfs"
    [ -x "$OUT/limine/bin/limine" ] || die "limine missing; run: l2 build limine"
    have xorriso || die "xorriso is required"
    local lim=$OUT/limine/share/limine isod=$ISO_DIR.$label log=$LOGS/iso.log
    [ "$label" != desktop ] || log=$LOGS/iso-desktop.log
    rm -rf "$isod"; mkdir -p "$isod/boot/limine" "$isod/EFI/BOOT" "$isod/l2"
    install -m 0644 "$OUT/vmlinuz-l2" "$isod/boot/vmlinuz"
    install -m 0644 "$initrd" "$isod/boot/initramfs"
    install -m 0644 "$lim/limine-bios.sys" "$isod/boot/limine/limine-bios.sys"
    install -m 0644 "$lim/limine-bios-cd.bin" "$isod/boot/limine/limine-bios-cd.bin"
    install -m 0644 "$lim/BOOTX64.EFI" "$isod/EFI/BOOT/BOOTX64.EFI"
    sed "s|@CMDLINE@|$(cmdline_base)|g" "$L2_ROOT/config/limine.conf" > "$isod/boot/limine/limine.conf"
    cp "$isod/boot/limine/limine.conf" "$isod/EFI/BOOT/limine.conf"
    # EFI El Torito boot image.  OVMF only boots Limine's stock 2.8 MiB image
    # (smaller/reformatted FAT images are rejected), so use it as-is.
    local ueficd=$isod/boot/limine/limine-uefi-cd.bin
    install -m 0644 "$lim/limine-uefi-cd.bin" "$ueficd"
    printf 'L2 live medium %s\n' "$APP_VERSION" > "$isod/l2/L2-LIVE"
    if [ "$wifi" = 1 ]; then
        [ -d "$BUILD/wifi" ] || die "wifi pack missing; run: l2 build wifipack"
        mkdir -p "$isod/l2/wifi"; cp -a "$BUILD/wifi/." "$isod/l2/wifi/"
    elif [ -d "$BUILD/hw" ]; then
        # core ISO: on-demand hardware drivers ride on the medium, not in RAM
        mkdir -p "$isod/l2/hw"; cp -a "$BUILD/hw/." "$isod/l2/hw/"
    fi
    # disk-install tools (sgdisk/mke2fs/mkfs.fat/limine) ride on the medium so
    # `l2install disk` works from inside the live system; zero idle RAM cost
    if [ -d "$BUILD/installtools" ]; then
        mkdir -p "$isod/l2/install"; cp -a "$BUILD/installtools/." "$isod/l2/install/"
    else
        warn "no install pack (l2 build installpack): l2install disk will not work from the live system"
    fi
    # OpenSSL (~3 MiB) rides on the medium.  Default is the wifi ISO so the core
    # ISO stays under the 10 MiB budget (the UEFI boot image alone is 2.8 MiB).
    # Set L2_SSL=core to also put it on the core ISO (needs L2_ALLOW_BIG_ISO=1).
    local want_ssl=0
    if [ -d "$BUILD/ssl" ]; then
        case "${L2_SSL:-wifi}" in
            core) want_ssl=1 ;;
            wifi) [ "$wifi" = 1 ] && want_ssl=1 ;;
            off) want_ssl=0 ;;
        esac
    fi
    if [ "$want_ssl" = 1 ]; then mkdir -p "$isod/l2/ssl"; cp -a "$BUILD/ssl/." "$isod/l2/ssl/"; fi
    find "$isod" -exec touch -h -d "@$EPOCH" {} + 2>/dev/null || true
    mkdir -p "$(dirname "$out")"
    local args=(-as mkisofs -iso-level 3 -full-iso9660-filenames -R -r -J -volid L2
        -publisher "L2" -preparer "L2 reproducible build" -A "L2 $APP_VERSION"
        -b boot/limine/limine-bios-cd.bin -no-emul-boot -boot-load-size 4 -boot-info-table
        --efi-boot boot/limine/limine-uefi-cd.bin -efi-boot-part --efi-boot-image
        --protective-msdos-label -o "$out")
    job_begin "Creating $(basename "$out")" "$log"
    if ! xorriso "${args[@]}" "$isod" >"$log" 2>&1; then job_end 1; ui_logtail "$log"; die "ISO build failed"; fi
    if ! "$OUT/limine/bin/limine" bios-install "$out" >>"$log" 2>&1; then
        job_end 1; ui_logtail "$log"; die "limine bios-install failed on $out"
    fi
    printf '\114\062\000\001' | dd of="$out" bs=1 seek=440 conv=notrunc 2>/dev/null
    local size limit; size=$(stat -c%s "$out"); limit=$((limit_mb * 1024 * 1024))
    job_end 0 "$(ui_size "$size") of $limit_mb MiB"
    printf '  '; ui_bar "$size" "$limit" 28; printf '  %s / %s MiB\n' "$(ui_size "$size")" "$limit_mb"
    if [ "$size" -gt "$limit" ]; then
        if [ "$L2_ALLOW_BIG_ISO" = 1 ]; then warn "over the ${limit_mb} MiB budget (allowed by L2_ALLOW_BIG_ISO=1)"
        elif [ "$label" = desktop ]; then die "Desktop ISO exceeds L2_DESKTOP_ISO_LIMIT_MB=$limit_mb"
        else die "ISO is over the ${limit_mb} MiB budget; trim the kernel, set L2_SSL=wifi (openssl only on l2-wifi.iso) or L2_SSL=off, or L2_ALLOW_BIG_ISO=1"; fi
    fi
}

build_iso() {
    init_epoch
    if [ "${1:-}" = desktop ]; then
        desktop_iso
        return
    fi
    local out=${1:-$OUT/l2.iso}
    step "Core ISO (kernel + initramfs + hw/install packs, no wifi pack)"
    _make_iso "$out" "$L2_ISO_LIMIT_MB" core 0
    if [ -d "$BUILD/wifi" ] && [ -z "${1:-}" ]; then
        step "Wi-Fi ISO (same RAM footprint; modules + firmware stay on the medium)"
        _make_iso "$OUT/l2-wifi.iso" "${L2_WIFI_ISO_LIMIT_MB:-96}" wifi 1
    fi
}

# --------------------------------------------------------------- build set
. "$L2_ROOT/lib/desktop.sh"

build_one() {
    case "$1" in
        musl)       build_musl ;;
        headers)    build_headers --force ;;
        kernel|linux|linux-kernel) build_kernel ;;
        dash)       build_dash ;;
        busybox)    build_busybox ;;
        rcl2)       build_rcl2 ;;
        l2pm)       build_l2pm ;;
        l2wifi)     build_l2wifi ;;
        libnl)      build_libnl ;;
        wpa|wpa_supplicant) build_wpa ;;
        openssl|ssl) build_openssl ;;
        firmware)   build_firmware ;;
        wifipack)   build_wifipack ;;
        hwpack)     build_hwpack ;;
        l2gpt)      build_l2gpt ;;
        e2fsprogs|mke2fs) build_e2fsprogs ;;
        dosfstools|mkfs.fat) build_dosfstools ;;
        installpack) build_installpack ;;
        limine)     build_limine ;;
        rootfs)     build_rootfs ;;
        initramfs)  build_initramfs ;;
        desktop)    build_desktop ;;
        l2wm|xterm) desktop_packages "$1" ;;
        xorg) desktop_packages xserver_xorg-server xdriver_xf86-video-fbdev ;;
        xinit) desktop_packages xapp_xinit ;;
        desktop-input) desktop_packages xdriver_xf86-input-evdev xapp_xkbcomp xkeyboard-config ;;
        desktop-fonts) desktop_packages xfont_font-misc-misc xfont_font-alias xfont_font-cursor-misc ;;
        iso)        build_iso ;;
        *) die "unknown component: $1" ;;
    esac
}

ALL_COMPONENTS="musl kernel busybox dash rcl2 l2pm l2wifi openssl wpa firmware limine wifipack hwpack l2gpt e2fsprogs dosfstools installpack rootfs initramfs iso"

build_all() {
    mkdir -p "$SRC" "$OUT" "$LOGS" "$CACHE" "$BUILD/bin"
    local c n=0 t=0 t0; t0=$(date +%s)
    for c in $ALL_COMPONENTS; do t=$((t + 1)); done
    for c in $ALL_COMPONENTS; do
        n=$((n + 1))
        step "[$n/$t] $c"
        # wifi pieces are optional: a failed download must not block a bootable core ISO
        case "$c" in
            wpa|firmware|openssl)
                ( build_one "$c" ) || warn "$c failed; continuing without it (core ISO still builds)" ;;
            wifipack)
                ( build_wifipack ) || warn "no wifi pack; building the core ISO only" ;;
            *) build_one "$c" ;;
        esac
    done
    ok "all done in $(ui_secs $(( $(date +%s) - t0 )))"
}

build_components() {
    local sel
    sel=$(ui_multi "Components to build (space selects, enter confirms)" $ALL_COMPONENTS desktop l2wm xorg xinit xterm desktop-input desktop-fonts) || return 0
    [ -n "$sel" ] || return 0
    local c
    for c in $sel; do step "component: $c"; build_one "$c"; done
}

# --------------------------------------------------------------- package manager
pm_bin() {
    if [ -x "$OUT/l2pm" ]; then printf '%s' "$OUT/l2pm"
    elif [ -x "$L2_ROOT/l2pm/l2pm" ]; then printf '%s' "$L2_ROOT/l2pm/l2pm"
    else build_l2pm >/dev/null; printf '%s' "$OUT/l2pm"; fi
}

pm() {
    local b; b=$(pm_bin)
    local root=${L2PM_ROOT:-$BUILD/pmroot}
    local cc=${CC:-$(musl_cc)}
    L2PM_ROOT="$root" L2PM_RECIPES="$L2_ROOT/l2pm/recipes" CC="$cc" "$b" "$@"
}

pm_menu() {
    while :; do
        local c
        c=$(ui_choose "l2pm - content-addressed packages" \
            "Build a recipe (reproducibility check)" \
            "Build + install a recipe" \
            "Install a .l2p file" \
            "List installed packages" \
            "Verify the store" \
            "Garbage collect" \
            "l2pm self-test (RAM <10 MiB)" \
            "Back") || return 0
        case "$c" in
            "Build a recipe"*)
                local r; r=$(ui_input "Recipe name (in l2pm/recipes)" "l2pm")
                [ -n "$r" ] && { local f=$r; [ -f "$r" ] || f=$L2_ROOT/l2pm/recipes/$r.recipe; pm build "$f" --check; } ;;
            "Build + install"*)
                local r; r=$(ui_input "Recipe name" "l2pm")
                [ -n "$r" ] && { local f=$r; [ -f "$r" ] || f=$L2_ROOT/l2pm/recipes/$r.recipe; pm add "$f"; } ;;
            "Install a .l2p"*)
                local f; f=$(ui_input "Path to .l2p" "$OUT/l2pm-0.1.0.l2p")
                [ -n "$f" ] && pm install "$f" ;;
            "List installed"*) pm list ;;
            "Verify"*) pm verify ;;
            "Garbage collect"*) pm gc ;;
            "l2pm self-test"*) pm selftest ;;
            Back) return 0 ;;
        esac
    done
}

# --------------------------------------------------------------- dashboard
ui_header() {
    local kv; kv=$(lock_get kernel_version || echo "?")
    if [ -t 1 ] && [ -z "${L2_NOCLEAR:-}" ]; then clear 2>/dev/null || true; fi
    printf '\n'
    ui_logo "L2  ·  tiny Linux builder" \
        "v$APP_VERSION   musl · rcl2 · l2pm · limine" \
        "host    $DISTRO · $(uname -m) · -j$JOBS" \
        "kernel  $kv   ·   ISO gate ${L2_ISO_LIMIT_MB} MiB" \
        "" "$(paint $C_DIM 'arrows move   enter selects   ctrl-c quits')"
    printf '\n'
}

art_row() {  # label file
    if [ -f "$2" ]; then printf '%s,built,%s,\n' "$1" "$(ui_size "$(stat -c%s "$2")")"
    else printf '%s,missing,-,l2 build %s\n' "$1" "$1"; fi
}

dashboard() {
    {
        printf 'COMPONENT,STATE,SIZE,NEXT\n'
        art_row musl "$SYSROOT/lib/libc.a"
        art_row kernel "$OUT/vmlinuz-l2"
        art_row busybox "$OUT/busybox"
        art_row dash "$OUT/dash"
        art_row rcl2 "$OUT/rcl2"
        art_row l2pm "$OUT/l2pm"
        art_row l2wifi "$OUT/l2wifi"
        art_row wpa "$OUT/wpa_supplicant"
        art_row openssl "$OUT/openssl"
        art_row limine "$OUT/limine/bin/limine"
        art_row initramfs "$OUT/initramfs-l2"
        art_row iso "$OUT/l2.iso"
        art_row desktop "$OUT/l2-desktop.iso"
        art_row l2wm "$DESKTOP_BR/per-package/l2wm/target/usr/bin/l2wm"
        if [ -d "$BUILD/firmware" ]; then printf 'firmware,built,%s KiB,\n' "$(du -sk "$BUILD/firmware" | awk '{print $1}')"
        else printf 'firmware,missing,-,l2 build firmware\n'; fi
    } | ui_table
    if [ -f "$OUT/l2.iso" ]; then
        local s lim; s=$(stat -c%s "$OUT/l2.iso"); lim=$((L2_ISO_LIMIT_MB * 1024 * 1024))
        printf '\n  %s ' "$(paint $C_DIM 'ISO budget')"; ui_bar "$s" "$lim" 30
        printf '  %s / %s MiB\n' "$(ui_size "$s")" "$L2_ISO_LIMIT_MB"
    fi
    if [ -s "$KLOCAL" ]; then printf '  %s\n' "$(paint $C_DIM "kernel overrides active: $(grep -c '^CONFIG' "$KLOCAL") (l2 kernel show)")"; fi
    printf '\n'
}

# --------------------------------------------------------------- tests
ramtest() {
    have python3 || die "python3 is required for the RAM test"
    [ -f "$OUT/vmlinuz-l2" ] && [ -f "$OUT/initramfs-l2" ] || die "build the kernel and initramfs first"
    # Prefer the real ISO for the sweep: QEMU's -kernel/-initrd path keeps the
    # initrd in fw_cfg memory and reads ~1 MiB high.
    local isoargs=()
    [ -f "$OUT/l2.iso" ] && isoargs=(--iso "$OUT/l2.iso")
    python3 "$L2_ROOT/tools/ramtest.py" --kernel "$OUT/vmlinuz-l2" --initrd "$OUT/initramfs-l2" \
        --cmdline "$(cmdline_base)" "${isoargs[@]}" "$@"
}

bootiso() {
    have python3 || die "python3 is required"
    local iso=${1:-$OUT/l2.iso}; shift || true
    [ -f "$iso" ] || die "$iso not found; run: l2 iso"
    python3 "$L2_ROOT/tools/ramtest.py" --iso "$iso" "$@"
}

test_menu() {
    local c
    c=$(ui_menu "Tests (QEMU)" \
        "ram|RAM sweep: idle memory at 256M 1G 4G 16G of RAM" \
        "bios|Boot the ISO under BIOS and check the shell" \
        "uefi|Boot the ISO under UEFI (needs OVMF)" \
        "back|Back") || return 0
    case "$c" in
        ram) ramtest ;;
        bios) bootiso "$OUT/l2.iso" ;;
        uefi) bootiso "$OUT/l2.iso" --uefi ;;
    esac
}

# --------------------------------------------------------------- doctor
doctor() {
    init_epoch; detect_distro
    ui_header
    ui_kv distro "$DISTRO"; ui_kv arch "$(uname -m)"; ui_kv "host kernel" "$(uname -r)"
    ui_kv gum "$(have gum && gum --version | head -1 || echo missing)"; ui_kv jobs "$JOBS"
    printf '\n'
    deps_check || true
    if [ "$DISTRO" = nixos ]; then
        have nix-build || warn "desktop compilation requires nix-build for its FHS environment"
    else
        local tool
        for tool in /usr/bin/file wget rsync unzip c++ patch which bc flock; do
            have "$tool" || warn "desktop build tool missing: $tool"
        done
    fi
    printf '\n'; dashboard
    check_kernel_dropped "$OUT/kernel.config"
    if [ -s "$LOGS/kernel-dropped.txt" ]; then
        warn "kernel symbols dropped by olddefconfig (hardware support may be missing):"
        sed 's/^/    /' "$LOGS/kernel-dropped.txt" >&2
    fi
    if [ -f "$OUT/kernel.config" ]; then
        local sym miss=0
        for sym in BLK_DEV_NVME SATA_AHCI USB_XHCI_HCD USB_HID KEYBOARD_ATKBD SERIO_I8042 FB_EFI EXT4_FS \
                   BLK_DEV_SR ACPI SUSPEND CFG80211 MAC80211; do
            if ! grep -Eq "^CONFIG_$sym=(y|m)" "$OUT/kernel.config"; then warn "CONFIG_$sym is not enabled in the built kernel"; miss=1; fi
        done
        if [ "$miss" = 0 ]; then ok "real-hardware essentials present (NVMe, AHCI, USB, HID, PS/2, EFI fb, ACPI poweroff, wifi core)"; fi
    fi
    if [ -x "$OUT/l2pm" ]; then printf '\n'; L2PM_ROOT="$BUILD/pmroot" "$OUT/l2pm" selftest 2>&1 | sed 's/^/  /'; fi
}

install_shared() {
    [ -x "$L2_ROOT/l2install" ] || die "l2install missing"
    "$L2_ROOT/l2install" shared
}

# --------------------------------------------------------------- menu
menu() {
    if [ "$USE_GUM" = 0 ] && [ -t 1 ] && [ -t 0 ] && [ -z "${L2_PLAIN:-}" ] && ! have gum; then
        install_gum || true
        if have gum; then USE_GUM=1; fi
    fi
    local c
    while :; do
        ui_header; dashboard
        c=$(ui_menu "What now?" \
            "all|Build everything and make the ISOs" \
            "desktop|Build Desktop Edition (Xorg, l2wm, xterm) and ISO" \
            "desktop-iso|Repackage Desktop ISO" \
            "pick|Choose components to build" \
            "kernel|Kernel settings (wifi families, features, CPUs)" \
            "iso|Rebuild the ISOs only" \
            "test|Test in QEMU (RAM sweep, BIOS/UEFI boot)" \
            "install|Install L2 to disk or a disk image" \
            "pm|Package manager (l2pm)" \
            "deps|Install build dependencies for this distro" \
            "update|Update the source lock" \
            "doctor|System doctor" \
            "shared|Install l2pm / l2fetch / l2install on this machine" \
            "quit|Quit") || return 0
        case "$c" in
            all)     ui_confirm "Download sources and build everything (compiles a kernel)?" && build_all ;;
            desktop) build_desktop ;;
            desktop-iso) build_iso desktop ;;
            pick)    build_components ;;
            kernel)  kernel_menu ;;
            iso)     build_iso ;;
            test)    test_menu ;;
            install) "$L2_ROOT/l2install" menu ;;
            pm)      pm_menu ;;
            deps)    deps_install ;;
            update)  ui_confirm "Download latest sources and update $LOCK?" && update_sources ;;
            doctor)  doctor ;;
            shared)  install_shared ;;
            quit|"") return 0 ;;
        esac
        printf '\n'; ui_confirm "Back to the menu?" || return 0
    done
}

