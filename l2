  l2 version

environment:
  JOBS=8  L2_LOAD=6           parallelism per program (-j8 -l6)
  KERNEL_VERSION / MUSL_VERSION   override the lock
  L2_ISO_LIMIT_MB=10          core ISO size gate        L2_WIFI_ISO_LIMIT_MB=96
  L2_DESKTOP_ISO_LIMIT_MB=128 desktop ISO size gate     L2_DESKTOP_AUTOSTART=1  start X on tty1 login
  L2_WIFI_FAMILIES="mt7921 iwlwifi ..."   firmware families (config/wifi-firmware.list)
  L2_FIRMWARE_SRC=/lib/firmware           reuse an existing firmware tree
  L2_SSL=core|wifi|off        where the openssl pack goes (never in RAM)   L2_SSL_EMBED=1  put it in the initramfs
  L2_SSL_CA=1|file.pem        ship a CA bundle    L2_OPENSSL_ASM=1  asm (faster, bigger)   OPENSSL_VERSION=x.y.z
  L2_PLAIN=1  L2_ASCII=1  NO_COLOR=1      UI fallbacks
  L2_BUILD_DIR=...  SOURCE_DATE_EPOCH=...  HOST_CC=cc
USAGE
}

clean() {
    ui_confirm "Remove $BUILD (sources, binaries, ISOs)?" || return 0
    rm -rf "$BUILD"; ok "removed $BUILD"
}

# --------------------------------------------------------------- main
main() {
    init_epoch
    mkdir -p "$SRC" "$OUT" "$LOGS" "$CACHE" "$BUILD/bin"
    detect_distro
    trap 'job_kill; exit 130' INT TERM
    trap 'job_kill' EXIT

    local action=${1:-menu}
    [ $# -gt 0 ] && shift || true
    case "$action" in
        menu)        menu ;;
        deps)
            case "${1:-check}" in
                install|inst|i) deps_install ;;
                check|status)   deps_check ;;
                *) die "usage: l2 deps [install|check]" ;;
            esac ;;
        build)
            if [ "${1:-all}" = all ]; then build_all
            else local c; for c in "$@"; do build_one "$c"; done; fi ;;
        kernel)      kernel_cmd "$@" ;;
        iso)         build_iso "$@" ;;
        ram)         ramtest "$@" ;;
        bootiso)     bootiso "$@" ;;
        update)      update_sources ;;
        pm)          pm "$@" ;;
        fetch)       "$L2_ROOT/l2fetch" "$@" ;;
        shared)      install_shared ;;
        install)     exec "$L2_ROOT/l2install" "$@" ;;
        doctor)      doctor ;;
        clean)       clean ;;
        version|--version|-V) echo "l2 $APP_VERSION" ;;
        -h|--help|help) usage ;;
        *) die "unknown command '$action' (try: l2 --help)" ;;
    esac
}

main "$@"
