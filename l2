#!/usr/bin/env bash
# l2 - the L2 distro builder and TUI.
#
# One entry point for:
#   - per-distro build dependency installation (Debian, Arch, Gentoo, NixOS,
#     Alpine, Fedora, Void)
#   - source download and pinned, reproducible component builds
#       linux (latest stable, locked), musl, dash, busybox, rcl2, l2pm
#   - a usable tiny rootfs, gzip initramfs, and BIOS ISO under 10 MiB
#   - l2pm (content-addressed package manager), l2fetch and l2install
#
# Every compiler invocation uses -j8 -l6 by default (JOBS=8, L2_LOAD=6):
# at most 8 jobs, and no new job while the load average is >= 6, so a shared
# machine stays responsive.  Set JOBS=... / L2_LOAD=... to change it.
#
# The script is bash on the build host.  The installed system itself uses
# dash (POSIX sh) + busybox (core tools) and does not carry bash.

set -Eeuo pipefail
shopt -s nullglob

APP_VERSION="0.4.0"
SELF=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")
L2_ROOT=${L2_ROOT:-$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)}
BUILD=${L2_BUILD_DIR:-$L2_ROOT/build}
SRC=$BUILD/src
OUT=$BUILD/out
SYSROOT=$BUILD/sysroot
ROOTFS=$BUILD/rootfs
LOGS=$BUILD/logs
CACHE=$BUILD/cache
ISO_DIR=$BUILD/iso
LOCK=$L2_ROOT/sources.lock
JOBS=${JOBS:-8}
LOAD=${L2_LOAD:-6}
L2_ISO_LIMIT_MB=${L2_ISO_LIMIT_MB:-10}
L2_DESKTOP_ISO_LIMIT_MB=${L2_DESKTOP_ISO_LIMIT_MB:-128}
L2_ALLOW_BIG_ISO=${L2_ALLOW_BIG_ISO:-0}
WIFI_DIR=$BUILD/wifi
EPOCH=${SOURCE_DATE_EPOCH:-}
PREFIX=${PREFIX:-/usr/local}
DISTRO=""
YES=0
MUSL_CC=""

have() { command -v "$1" >/dev/null 2>&1; }

# shared UI (gum + plain fallbacks, job ticker, palette)
# shellcheck disable=SC1091
. "$L2_ROOT/lib/l2ui.sh"

# --------------------------------------------------------------- distro
detect_distro() {
    [ -n "$DISTRO" ] && return 0
    local id="" like=""
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        id=${ID:-}
        like=${ID_LIKE:-}
    fi
    case " $id $like " in
        *" nixos "*)  DISTRO=nixos ;;
        *" gentoo "*) DISTRO=gentoo ;;
        *" arch "*|*" manjaro "*) DISTRO=arch ;;
        *" debian "*|*" ubuntu "*) DISTRO=debian ;;
        *" alpine "*) DISTRO=alpine ;;
        *" fedora "*|*" rhel "*|*" centos "*) DISTRO=fedora ;;
        *" void "*)   DISTRO=void ;;
        *)            DISTRO=unknown ;;
    esac
}

nix_cmd() {
    if nix profile add --help >/dev/null 2>&1; then
        nix --extra-experimental-features "nix-command flakes" profile add "nixpkgs#$1"
    else
        nix --extra-experimental-features "nix-command flakes" profile install "nixpkgs#$1"
    fi
}

install_gum_release() {
    local arch url tmp
    case "$(uname -m)" in
        x86_64|amd64) arch=x86_64 ;;
        aarch64|arm64) arch=arm64 ;;
        *) warn "no prebuilt gum for $(uname -m)"; return 1 ;;
    esac
    have curl || die "curl is required to install gum"
    url=$(curl -fsSL https://api.github.com/repos/charmbracelet/gum/releases/latest \
        | grep -o "https://[^\"]*Linux_${arch}\\.tar\\.gz" | head -1 || true)
    [ -n "$url" ] || { warn "could not find a gum release URL"; return 1; }
    tmp=$(mktemp -d)
    say "installing gum from $url"
    if curl -fsSL "$url" | tar -xz -C "$tmp"; then
        if run_priv install -m 0755 "$tmp/gum" /usr/local/bin/gum; then
            rm -rf "$tmp"
            return 0
        fi
    fi
    rm -rf "$tmp"
    return 1
}

install_gum() {
    if have gum; then return 0; fi
    detect_distro
    say "gum is not installed; attempting to install it" >&2
    case "$DISTRO" in
        arch)   run_priv pacman -S --needed --noconfirm gum || install_gum_release ;;
        nixos)  nix_cmd gum || install_gum_release ;;
        gentoo) run_priv emerge -n app-misc/gum || install_gum_release ;;
        debian) run_priv apt-get install -y gum || install_gum_release ;;
        fedora) run_priv dnf install -y gum || install_gum_release ;;
        alpine) run_priv apk add gum || install_gum_release ;;
        void)   run_priv xbps-install -Sy gum || install_gum_release ;;
        *)      install_gum_release || true ;;
    esac
    have gum || warn "gum still unavailable; using the plain prompt fallback"
}

# --------------------------------------------------------------- deps
run_priv() {
    if [ "$(id -u)" -eq 0 ]; then "$@"
    elif have sudo; then sudo "$@"
    else die "need root or sudo for: $*"
    fi
}

APT_PKGS=(build-essential clang lld llvm musl-tools bc bison flex libelf-dev libssl-dev
          cpio xz-utils xorriso mtools qemu-system-x86 git curl ca-certificates rsync pkg-config
          file kmod busybox-static nasm llvm dosfstools gdisk parted rustc cargo gzip tar python3 bzip2 perl)
ARCH_PKGS=(base-devel clang lld llvm musl bc bison flex libelf openssl cpio xz libisoburn
           mtools nasm qemu-system-x86 git curl ca-certificates rsync pkg-config file kmod
           busybox dosfstools gptfdisk parted rust gzip tar python3 bzip2 perl)
GENTOO_PKGS=(sys-devel/clang sys-devel/lld sys-devel/llvm sys-libs/musl sys-devel/bc
             sys-devel/bison sys-devel/flex dev-libs/elfutils dev-libs/openssl app-arch/cpio
             app-arch/xz-utils sys-fs/xorriso app-emulation/mtools app-emulation/qemu
             dev-vcs/git net-misc/curl app-admin/rsync dev-util/pkgconf sys-apps/file sys-apps/kmod
             sys-apps/busybox dev-lang/nasm sys-fs/dosfstools sys-apps/gptfdisk
             sys-apps/parted dev-lang/rust dev-lang/python app-arch/bzip2 dev-lang/perl)
NIX_PKGS=(gnumake gcc clang lld llvm rustc cargo musl bc bison flex elfutils.dev openssl.dev pkg-config cpio
          xz xorriso mtools nasm qemu git curl cacert rsync file kmod busybox
          dosfstools gptfdisk parted gzip gnutar gnum4 gum python3 bzip2 perl)
ALPINE_PKGS=(build-base clang lld llvm musl-dev bc bison flex elfutils-dev openssl-dev
             cpio xz xorriso mtools nasm qemu-system-x86_64 git curl ca-certificates rsync
             pkgconf file kmod busybox dosfstools gptfdisk parted rust cargo gzip tar python3 bzip2 perl)
FEDORA_PKGS=("@development-tools" clang lld llvm musl-gcc bc bison flex elfutils-libelf-devel
             openssl-devel cpio xz xorriso mtools nasm qemu-system-x86 git curl ca-certificates
             rsync pkgconf file kmod busybox dosfstools gdisk parted
             rust cargo gzip tar python3 bzip2 perl perl-FindBin perl-IPC-Cmd perl-File-Compare perl-File-Copy)

deps_install() {
    detect_distro
    step "Installing build dependencies for $DISTRO"
    case "$DISTRO" in
        debian)
            run_priv apt-get update
            run_priv env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${APT_PKGS[@]}"
            ;;
        arch)
            run_priv pacman -Sy --needed --noconfirm "${ARCH_PKGS[@]}"
            ;;
        gentoo)
            run_priv emerge --ask=n --noreplace "${GENTOO_PKGS[@]}"
            ;;
        nixos)
            local p
            for p in "${NIX_PKGS[@]}"; do nix_cmd "$p" || warn "nix package $p was not installed"; done
            ;;
        alpine)
            run_priv apk add --no-cache "${ALPINE_PKGS[@]}"
            ;;
        fedora)
            run_priv dnf install -y "${FEDORA_PKGS[@]}"
            ;;
        void)
            run_priv xbps-install -Sy build-essential clang lld musl-devel bc bison flex
            run_priv xbps-install -Sy libelf-devel openssl-devel cpio xz xorriso mtools
            run_priv xbps-install -Sy qemu git curl rsync file kmod busybox nasm llvm lld
            run_priv xbps-install -Sy dosfstools gptfdisk parted rust cargo gzip tar python3 bzip2 perl
            ;;
        *)
            warn "unknown distribution; install these manually:"
            printf '  %s\n' "clang lld llvm rustc make bc bison flex libelf openssl cpio xz xorriso mtools nasm qemu git curl rsync file kmod busybox dosfstools gdisk parted musl"
            return 1
            ;;
    esac
    have gum || install_gum || true
    deps_check || true
}

deps_check() {
    local tools=(curl git tar gzip xz bzip2 cpio make cc clang rustc ld.lld llvm-objcopy
                 bc bison flex nasm xorriso mtools sgdisk parted mkfs.ext4 mkfs.fat
                 sha256sum strip depmod python3 perl qemu-system-x86_64)
    local t missing=0 n=0
    printf '\n'
    for t in "${tools[@]}"; do
        if have "$t"; then printf '  %s' "$(ui_state ok "$(printf '%-18s' "$t")")"
        else printf '  %s' "$(ui_state err "$(printf '%-18s' "$t")")"; missing=$((missing + 1)); fi
        n=$((n + 1)); [ $((n % 3)) -eq 0 ] && printf '\n'
    done
    printf '\n'
    [ "$missing" -gt 0 ] && warn "$missing tool(s) missing: l2 deps install"
    return "$missing"
}

# --------------------------------------------------------------- lock
lock_get() {
    [ -r "$LOCK" ] || return 1
    awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$LOCK"
}

lock_set() {
    local k=$1 v=$2 tmp
    tmp=$(mktemp "$LOCK.XXXXXX")
    if [ -r "$LOCK" ]; then
        awk -F= -v k="$k" -v v="$v" '
            BEGIN { done = 0 }
            $1 == k { print k "=" v; done = 1; next }
            { print }
            END { if (!done) print k "=" v }
        ' "$LOCK" > "$tmp"
    else
        printf '%s=%s\n' "$k" "$v" > "$tmp"
    fi
    chmod 0644 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$LOCK"
}

init_epoch() {
    if [ -z "$EPOCH" ]; then EPOCH=$(lock_get epoch || true); fi
    [ -n "$EPOCH" ] || EPOCH=1767225600
    export SOURCE_DATE_EPOCH="$EPOCH"
    export TZ=UTC LC_ALL=C LANG=C
    umask 022
}

sha256_of() {
    local f=$1
    if have sha256sum; then sha256sum "$f" | cut -d' ' -f1
    elif have shasum; then shasum -a 256 "$f" | cut -d' ' -f1
    elif have openssl; then openssl dgst -sha256 "$f" | sed 's/.* //'
    else die "no sha256 tool (sha256sum/shasum/openssl)"; fi
}

verify_sha() {
    local f=$1 want=$2 got
    [ -n "$want" ] || return 0
    [ -f "$f" ] || return 1
    got=$(sha256_of "$f")
    if [ "$got" != "$want" ]; then
        die "sha256 mismatch for $f
  expected $want
  got      $got"
    fi
}

download() {
    local url=$1 dest=$2 want=$3 title=${4:-download}
    mkdir -p "$(dirname "$dest")"
    if [ -f "$dest" ] && { [ -z "$want" ] || [ "$(sha256_of "$dest")" = "$want" ]; }; then
        say "$title: cached"
        return 0
    fi
    step "$title"
    rm -f "$dest.part"
    if have curl; then
        ui_spin "$title" curl -fL --retry 3 --connect-timeout 20 -o "$dest.part" "$url"
    elif have wget; then
        ui_spin "$title" wget -O "$dest.part" "$url"
    else
        die "curl or wget is required"
    fi
    mv "$dest.part" "$dest"
    if [ -n "$want" ]; then verify_sha "$dest" "$want"; else
        warn "no pinned sha256 for $dest"
    fi
}

latest_kernel() {
    curl -fsSL --max-time 30 https://www.kernel.org/releases.json \
        | awk -F'"' '/"moniker": "stable"/ { s = 1 } s && /"version"/ { print $4; exit }'
}

latest_musl() {
    curl -fsSL --max-time 30 https://musl.libc.org/releases.html \
        | grep -o 'musl-[0-9][0-9.]*\.tar\.gz' | sort -V | tail -1 \
        | sed 's/^musl-//; s/\.tar\.gz$//'
}

latest_dash() {
    curl -fsSL --max-time 30 http://gondor.apana.org.au/~herbert/dash/files/ \
        | grep -o 'dash-[0-9][0-9.]*\.tar\.gz' | sort -V | tail -1 \
        | sed 's/^dash-//; s/\.tar\.gz$//'
}

latest_limine() {
    git ls-remote --tags https://github.com/limine-bootloader/limine.git 2>/dev/null \
        | sed 's#.*refs/tags/##' | grep -E '^v[0-9]+(\.[0-9]+)+$' \
        | sed 's/^v//' | sort -V | tail -1
}

update_sources() {
    init_epoch
    have curl || die "curl is required"
    step "Resolving latest stable sources"
    local k m d lm ksum mfile
    k=$(latest_kernel)
    m=$(latest_musl)
    d=$(latest_dash)
    lm=$(latest_limine)
    [ -n "$k" ] || die "cannot resolve latest kernel"
    [ -n "$m" ] || die "cannot resolve latest musl"
    [ -n "$d" ] || die "cannot resolve latest dash"
    [ -n "$lm" ] || die "cannot resolve latest limine release"

    ksum=$(curl -fsSL --max-time 30 "https://cdn.kernel.org/pub/linux/kernel/v${k%%.*}.x/sha256sums.asc" \
        | awk -v f="linux-$k.tar.xz" '$2 == f { print $1; exit }')
    [ -n "$ksum" ] || warn "no kernel sha256 published for $k"

    mkdir -p "$CACHE"
    mfile=$CACHE/musl-$m.tar.gz
    download "https://musl.libc.org/releases/musl-$m.tar.gz" "$mfile" "" "musl $m"
    local msum; msum=$(sha256_of "$mfile")
    local dfile=$CACHE/dash-$d.tar.gz
    download "http://gondor.apana.org.au/~herbert/dash/files/dash-$d.tar.gz" "$dfile" "" "dash $d"
    local dsum; dsum=$(sha256_of "$dfile")
    local lmfile=$CACHE/limine-$lm.tar.gz
    download "https://codeberg.org/Limine/Limine/releases/download/v$lm/limine-$lm.tar.gz" \
        "$lmfile" "" "limine $lm"
    local lmsum; lmsum=$(sha256_of "$lmfile")

    lock_set kernel_version "$k"
    lock_set kernel_sha256 "$ksum"
    lock_set musl_version "$m"
    lock_set musl_sha256 "$msum"
    lock_set dash_version "$d"
    lock_set dash_sha256 "$dsum"
    lock_set limine_version "$lm"
    lock_set limine_source "https://codeberg.org/Limine/Limine/releases/download/v$lm/limine-$lm.tar.gz"
    lock_set limine_sha256 "$lmsum"
    printf '\n%s\n' "updated $LOCK"
    printf '  kernel  %s\n  musl    %s\n  dash    %s\n  limine  %s\n' \
        "$k" "$m" "$d" "$lm"
}

# --------------------------------------------------------------- musl
build_musl() {
    init_epoch
    local ver tarball sha dir log
    ver=${MUSL_VERSION:-$(lock_get musl_version || true)}
    [ -n "$ver" ] || ver=$(latest_musl)
    sha=$(lock_get musl_sha256 || true)
    if [ "${1:-}" != "--force" ] && [ -f "$SYSROOT/lib/libc.a" ]; then
        say "musl $ver already installed in $SYSROOT"
    else
        tarball=$CACHE/musl-$ver.tar.gz
        download "https://musl.libc.org/releases/musl-$ver.tar.gz" "$tarball" "$sha" "musl $ver source"
        dir=$SRC/musl-$ver
        rm -rf "$dir"
        mkdir -p "$SRC"
        tar -xf "$tarball" -C "$SRC"
        log=$LOGS/musl.log
        job_begin "Building musl $ver (-j$JOBS -l$LOAD)" "$log"
        if ! (
            cd "$dir"
            ./configure --prefix="$SYSROOT" --disable-shared --enable-static \
                CC="${HOST_CC:-cc}" CFLAGS="-Os -ffile-prefix-map=$PWD=. -fdebug-prefix-map=$PWD=."
            make -j"$JOBS" -l"$LOAD"
            make install
        ) >"$log" 2>&1; then
            job_end 1; ui_logtail "$log" 60
            die "musl build failed (log: $log)"
        fi
        job_end 0
    fi
    make_musl_wrapper "$ver"
}

make_musl_wrapper() {
    local ver=$1 specs=$SYSROOT/lib/musl-gcc.specs wrapper=$BUILD/bin/musl-gcc
    mkdir -p "$BUILD/bin"
    if [ ! -f "$SYSROOT/lib/libc.a" ]; then
        MUSL_CC="${HOST_CC:-cc}"
        warn "musl sysroot missing; using $MUSL_CC (static glibc fallback)"
        return 0
    fi
    # specs generation ships with musl; no musl-gcc package needed.
    if [ -f "$SRC/musl-$ver/tools/musl-gcc.specs.sh" ]; then
        sh "$SRC/musl-$ver/tools/musl-gcc.specs.sh" \
            "$SYSROOT/include" "$SYSROOT/lib" /lib/ld-musl-x86_64.so.1 > "$specs"
    else
        warn "musl specs generator missing; trying system musl-gcc"
        if have musl-gcc; then MUSL_CC=$(command -v musl-gcc); return 0; fi
        MUSL_CC="${HOST_CC:-cc}"
        return 0
    fi
    # Nix's gcc wrapper injects -latomic_asneeded; an empty archive satisfies
    # the driver without pulling any code into the static binary.
    printf '!<arch>\n' > "$SYSROOT/lib/libatomic_asneeded.a"
    cat > "$wrapper" <<EOF
#!/bin/sh
exec "${HOST_CC:-cc}" -specs "$specs" "\$@"
EOF
    chmod 0755 "$wrapper"
    # smoke test: a static musl binary must link and run
    local t=$BUILD/musl-smoke
    printf '#include <stdio.h>\nint main(void){puts("musl");return 0;}\n' > "$t.c"
    if "$wrapper" -static -Os -o "$t" "$t.c" >/dev/null 2>&1 && "$t" >/dev/null 2>&1; then
        MUSL_CC=$wrapper
        say "musl toolchain ready: $MUSL_CC"
    else
        MUSL_CC="${HOST_CC:-cc}"
        warn "generated musl wrapper failed its smoke test; falling back to $MUSL_CC"
    fi
}

musl_cc() {
    if [ -n "$MUSL_CC" ]; then printf '%s' "$MUSL_CC"
    elif [ -x "$BUILD/bin/musl-gcc" ]; then printf '%s' "$BUILD/bin/musl-gcc"
    elif have musl-gcc; then command -v musl-gcc
    else printf '%s' "${HOST_CC:-cc}"; fi
}

with_musl() {
    local cc; cc=$(musl_cc)
    # Add static explicitly: the wrapper is a normal gcc driver.
    if [ "$cc" = "${HOST_CC:-cc}" ]; then
        warn "building with the host libc (musl unavailable)"
    fi
    printf '%s' "$cc"
}

# --------------------------------------------------------------- kernel
# Local, user-editable kernel overrides live in config/kernel.local and are
# merged AFTER config/kernel.fragment, so `l2 kernel` (menu or `set`) changes
# the build without touching the shipped fragment.
KLOCAL=$L2_ROOT/config/kernel.local

klocal_set() {   # CONFIG_FOO=value
    local sym=${1%%=*}
    [ -f "$KLOCAL" ] || printf '# L2 local kernel overrides (managed by `l2 kernel`)\n' > "$KLOCAL"
    sed -i "/^${sym}=/d;/^# ${sym} is not set/d" "$KLOCAL"
    printf '%s\n' "$1" >> "$KLOCAL"
}

kfam_syms() {
    case "$1" in
        intel)    echo "CONFIG_IWLWIFI CONFIG_IWLDVM CONFIG_IWLMVM" ;;
        mediatek) echo "CONFIG_MT7921E CONFIG_MT7921U CONFIG_MT7925E" ;;
        realtek)  echo "CONFIG_RTW88 CONFIG_RTW89 CONFIG_RTL8XXXU" ;;
        atheros)  echo "CONFIG_ATH9K CONFIG_ATH9K_HTC CONFIG_ATH10K CONFIG_ATH11K CONFIG_ATH12K" ;;
        broadcom) echo "CONFIG_BRCMFMAC" ;;
    esac
}

kernel_menu() {
    local c
    while :; do
        c=$(ui_menu "Kernel settings (saved in config/kernel.local)" \
            "wifi|Wi-Fi driver families (modules, zero idle RAM until used)" \
            "feat|Optional features (IPv6, USB ethernet, VM guest tweaks)" \
            "cpus|Maximum CPUs (NR_CPUS, per-CPU kernel memory)" \
            "raw|Set any CONFIG_ symbol by hand" \
            "show|Show current overrides" \
            "reset|Remove all overrides" \
            "back|Back") || return 0
        case "$c" in
            wifi)
                local sel f s
                sel=$(YES=0 ui_multi "Keep these Wi-Fi families (unselected are removed)" \
                    intel mediatek realtek atheros broadcom) || continue
                for f in intel mediatek realtek atheros broadcom; do
                    for s in $(kfam_syms "$f"); do
                        if printf '%s\n' "$sel" | grep -qx "$f"; then klocal_set "$s=m"; else klocal_set "$s=n"; fi
                    done
                done
                ok "saved; rebuild with: l2 build kernel" ;;
            feat)
                local sel
                sel=$(YES=0 ui_multi "Enable" ipv6 usb-ethernet vm-guest) || continue
                printf '%s\n' "$sel" | grep -qx ipv6 && klocal_set CONFIG_IPV6=y || klocal_set CONFIG_IPV6=n
                if printf '%s\n' "$sel" | grep -qx usb-ethernet; then
                    klocal_set CONFIG_USB_RTL8152=y; klocal_set CONFIG_USB_NET_CDC_NCM=y; klocal_set CONFIG_USB_NET_CDCETHER=y
                else
                    klocal_set CONFIG_USB_RTL8152=n; klocal_set CONFIG_USB_NET_CDC_NCM=n; klocal_set CONFIG_USB_NET_CDCETHER=n
                fi
                if printf '%s\n' "$sel" | grep -qx vm-guest; then
                    klocal_set CONFIG_HYPERVISOR_GUEST=y; klocal_set CONFIG_PARAVIRT=y; klocal_set CONFIG_KVM_GUEST=y
                fi
                ok "saved; rebuild with: l2 build kernel" ;;
            cpus)
                local n; n=$(ui_input "NR_CPUS (1-512, default 8)" "8" "8") || continue
                case "$n" in ''|*[!0-9]*) warn "not a number" ;; *) klocal_set "CONFIG_NR_CPUS=$n"; ok "NR_CPUS=$n" ;; esac ;;
            raw)
                local v; v=$(ui_input "CONFIG_SYMBOL=value (y, m, n or a number)" "CONFIG_HZ_250=y") || continue
                case "$v" in CONFIG_*=*) klocal_set "$v"; ok "saved $v" ;; *) warn "expected CONFIG_NAME=value" ;; esac ;;
            show) if [ -s "$KLOCAL" ]; then sed 's/^/  /' "$KLOCAL"; else note "no overrides"; fi ;;
            reset) rm -f "$KLOCAL"; ok "overrides removed" ;;
            back) return 0 ;;
        esac
    done
}

kernel_cmd() {   # l2 kernel [menu|set CONFIG_X=v|show|reset]
    case "${1:-menu}" in
        menu) kernel_menu ;;
        set)  shift; [ $# -gt 0 ] || die "usage: l2 kernel set CONFIG_X=value ..."
              for a in "$@"; do case "$a" in CONFIG_*=*) klocal_set "$a" ;; *) die "bad symbol: $a" ;; esac; done ;;
        show) [ -s "$KLOCAL" ] && cat "$KLOCAL" || echo "(no overrides)" ;;
        reset) rm -f "$KLOCAL" ;;
        *) die "usage: l2 kernel [menu|set CONFIG_X=v|show|reset]" ;;
    esac
}

ensure_kernel_src() {
    local ver=$1 major=${1%%.*} tarball=$CACHE/linux-$1.tar.xz
    download "https://cdn.kernel.org/pub/linux/kernel/v${major}.x/linux-$ver.tar.xz" \
        "$tarball" "$(lock_get kernel_sha256 || true)" "linux $ver source"
    if [ ! -f "$SRC/linux-$ver/Makefile" ]; then
        mkdir -p "$SRC"; step "Extracting linux $ver"; tar -xf "$tarball" -C "$SRC"
    fi
}

# kernel uAPI headers for musl-built userland (busybox, libnl, wpa_supplicant)
build_headers() {
    init_epoch
    local ver; ver=${KERNEL_VERSION:-$(lock_get kernel_version || true)}
    [ -f "$SYSROOT/include/linux/nl80211.h" ] && [ "${1:-}" != --force ] && return 0
    ensure_kernel_src "$ver"
    local log=$LOGS/headers.log
    job_begin "Installing kernel headers" "$log"
    if ! ( cd "$SRC/linux-$ver" && make -s headers_install INSTALL_HDR_PATH="$SYSROOT" ) >"$log" 2>&1; then
        job_end 1; ui_logtail "$log"; die "headers_install failed"
    fi
    job_end 0
}

check_kernel_dropped() {
    local cfg=${1:-$OUT/kernel.config}
    [ -f "$cfg" ] || return 0
    local frags=("$L2_ROOT/config/kernel.fragment")
    [ -s "$KLOCAL" ] && frags+=("$KLOCAL")
    local dropped=$LOGS/kernel-dropped.txt
    mkdir -p "$LOGS"
    awk '
        FNR == NR {
            if ($0 ~ /^CONFIG_[A-Za-z0-9_]+=/) {
                eq = index($0, "=")
                s = substr($0, 1, eq - 1)
                got[s] = substr($0, eq + 1)
            } else if ($0 ~ /^# CONFIG_[A-Za-z0-9_]+ is not set$/) {
                s = $2
                got[s] = "n"
            }
            next
        }
        {
            sub(/[[:space:]]+$/, "")
            if ($0 ~ /^# CONFIG_[A-Za-z0-9_]+ is not set$/) {
                s = $2
                if (!(s in want)) order[++n] = s
                want[s] = "n"
                next
            }
            sub(/[[:space:]]+#.*/, "")
            sub(/[[:space:]]+$/, "")
            if ($0 ~ /^CONFIG_[A-Za-z0-9_]+=/) {
                eq = index($0, "=")
                s = substr($0, 1, eq - 1)
                v = substr($0, eq + 1)
                if (!(s in want)) order[++n] = s
                want[s] = v
            }
        }
        END {
            for (i = 1; i <= n; i++) {
                s = order[i]
                v = want[s]
                if (v == "n") {
                    if (s in got && got[s] != "n")
                        printf "%s=n (got %s)\n", s, got[s]
                } else {
                    g = (s in got) ? got[s] : "absent"
                    if (g != v)
                        printf "%s=%s (got %s)\n", s, v, g
                }
            }
        }
    ' "$cfg" "${frags[@]}" > "$dropped"
}

build_kernel() {
    init_epoch
    if [ "$DISTRO" = nixos ]; then
        local nd
        for nd in "$HOME/.nix-profile" /run/current-system/sw; do
            [ -d "$nd/include" ] && CPATH="$nd/include${CPATH:+:$CPATH}"
            [ -d "$nd/lib" ] && LIBRARY_PATH="$nd/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
            [ -d "$nd/lib/pkgconfig" ] && PKG_CONFIG_PATH="$nd/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
            [ -d "$nd/share/pkgconfig" ] && PKG_CONFIG_PATH="$nd/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
        done
        export CPATH LIBRARY_PATH PKG_CONFIG_PATH
    fi
    local ver dir log stamp krel
    ver=${KERNEL_VERSION:-$(lock_get kernel_version || true)}
    [ -n "$ver" ] || ver=$(latest_kernel)
    ensure_kernel_src "$ver"
    dir=$SRC/linux-$ver
    rm -rf "$dir"; mkdir -p "$SRC"
    step "Extracting linux $ver"
    tar -xf "$CACHE/linux-$ver.tar.xz" -C "$SRC"
    python3 "$L2_ROOT/tools/patch-kernel-ram.py" "$dir" || die "kernel RAM patch failed"
    log=$LOGS/kernel.log
    stamp=$(date -u -d "@$EPOCH" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '2026-01-01 00:00:00')
    local frags=("$L2_ROOT/config/kernel.fragment")
    [ -s "$KLOCAL" ] && frags+=("$KLOCAL")
    [ -s "$KLOCAL" ] && say "applying local overrides: $KLOCAL"
    local norm_frags=() f nf i=0
    for f in "${frags[@]}"; do
        nf=$dir/.l2-frag-$i
        sed -E 's/^(CONFIG_[A-Za-z0-9_]+)=n([[:space:]]*(#.*)?)$/# \1 is not set/' "$f" > "$nf"
        norm_frags+=("$nf")
        i=$((i + 1))
    done
    job_begin "Configuring linux $ver (tinyconfig + L2 fragment)" "$log"
    if ! (
        cd "$dir"
        export KBUILD_BUILD_TIMESTAMP="$stamp" KBUILD_BUILD_USER=l2 KBUILD_BUILD_HOST=l2 KBUILD_BUILD_VERSION=1
        make tinyconfig
        scripts/kconfig/merge_config.sh -m .config "${norm_frags[@]}" >/dev/null 2>&1 \
            || cat "${norm_frags[@]}" >> .config
        make olddefconfig
        scripts/config --set-str LOCALVERSION "-l2" 2>/dev/null || true
    ) >"$log" 2>&1; then rm -f "${norm_frags[@]}"; job_end 1; ui_logtail "$log" 60; die "kernel configure failed (log: $log)"; fi
    rm -f "${norm_frags[@]}"
    job_end 0
    # symbols that did not survive olddefconfig (renamed, missing dependency)
    check_kernel_dropped "$dir/.config"
    local dropped=$LOGS/kernel-dropped.txt
    if [ -s "$dropped" ]; then
        warn "$(wc -l < "$dropped") fragment symbols were dropped or changed by this kernel (see $dropped)"
        head -n 6 "$dropped" | sed 's/^/    /' >&2
    fi
    job_begin "Building linux $ver (-j$JOBS -l$LOAD bzImage + modules)" "$log"
    if ! (
        cd "$dir"
        export KBUILD_BUILD_TIMESTAMP="$stamp" KBUILD_BUILD_USER=l2 KBUILD_BUILD_HOST=l2 KBUILD_BUILD_VERSION=1
        make -j"$JOBS" -l"$LOAD" bzImage
        make -j"$JOBS" -l"$LOAD" modules
        make -s headers_install INSTALL_HDR_PATH="$SYSROOT"
    ) >>"$log" 2>&1; then job_end 1; ui_logtail "$log" 80; die "kernel build failed (log: $log)"; fi
    [ -f "$dir/arch/x86/boot/bzImage" ] || { job_end 1; die "kernel image missing after build"; }
    job_end 0 "$(ui_size "$(stat -c%s "$dir/arch/x86/boot/bzImage")")"
    mkdir -p "$OUT"
    install -m 0644 "$dir/arch/x86/boot/bzImage" "$OUT/vmlinuz-l2"
    install -m 0644 "$dir/arch/x86/boot/bzImage" "$OUT/vmlinuz-$ver-l2"
    cp "$dir/.config" "$OUT/kernel.config"
    # loadable modules (wifi) into a staging root, stripped, with dependency maps
    krel=$(cd "$dir" && make -s kernelrelease)
    printf '%s\n' "$krel" > "$OUT/kernelrelease"
    rm -rf "$BUILD/modroot"
    if grep -q '^CONFIG_MODULES=y' "$dir/.config"; then
        ( cd "$dir" && make -s modules_install INSTALL_MOD_PATH="$BUILD/modroot" INSTALL_MOD_STRIP=1 ) >>"$log" 2>&1 \
            || die "modules_install failed (log: $log)"
        rm -f "$BUILD/modroot/lib/modules/$krel/build" "$BUILD/modroot/lib/modules/$krel/source"
        if have depmod; then depmod -b "$BUILD/modroot" "$krel" 2>>"$log" || warn "depmod failed"
        else warn "depmod (kmod) not found: modprobe will not resolve module dependencies"; fi
        say "modules: $(find "$BUILD/modroot/lib/modules/$krel" -name '*.ko' | wc -l) built, $(du -sk "$BUILD/modroot" | awk '{print $1}') KiB"
    fi
    say "kernel $krel: $OUT/vmlinuz-l2"
}

# --------------------------------------------------------------- dash
build_dash() {
    init_epoch
    local ver sha tarball dir log
    ver=$(lock_get dash_version || true)
    [ -n "$ver" ] || ver=$(latest_dash)
    sha=$(lock_get dash_sha256 || true)
    tarball=$CACHE/dash-$ver.tar.gz
    download "http://gondor.apana.org.au/~herbert/dash/files/dash-$ver.tar.gz" \
        "$tarball" "$sha" "dash $ver source"
    dir=$SRC/dash-$ver
    rm -rf "$dir"
    mkdir -p "$SRC"
    tar -xf "$tarball" -C "$SRC"
    log=$LOGS/dash.log
    job_begin "Building dash $ver (-j$JOBS -l$LOAD)" "$log"
    local cc; cc=$(with_musl)
    if ! (
        cd "$dir"
        ./configure --prefix=/usr --bindir=/bin --sysconfdir=/etc --localstatedir=/var \
            CC="$cc" CFLAGS="-static -Os -ffunction-sections -fdata-sections -ffile-prefix-map=$PWD=. -fdebug-prefix-map=$PWD=." \
            LDFLAGS="-static -Wl,--gc-sections"
        make -j"$JOBS" -l"$LOAD"
    ) >"$log" 2>&1; then
        job_end 1; ui_logtail "$log" 60
        die "dash build failed (log: $log)"
    fi
    job_end 0
    install -m 0755 "$dir/src/dash" "$OUT/dash"
    have strip && strip -s "$OUT/dash" 2>/dev/null || true
    say "dash: $OUT/dash ($(stat -c%s "$OUT/dash") bytes)"
}

# --------------------------------------------------------------- rcl2
build_rcl2() {
